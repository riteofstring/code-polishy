{
  "$schema": "schema/code-polishy.schema.json",
  "version": 3,
  "project": {
    "kind": "tooling",
    "capabilities": ["cli"]
  },
  "scope": {
    "exclude": [],
    "generated": [],
    "entryPoints": [
      "tools/javascript/bundle-manifest.mjs",
      "tools/javascript/runner.mjs"
    ]
  },
  "quality": {},
  "documentation": {
    "design": [
      {
        "path": "docs/design/agent-guidance.md",
        "module": "agents"
      }
    ]
  },
  "verification": {
    "finalGateOwner": "ci",
    "mergeGate": {
      "recommendedModules": [
        "policy",
        "repository",
        "runner",
        "gaterun",
        "finalstate",
        "behaviorreview",
        "documentation",
        "agents",
        "release",
        "javascript",
        "quality",
        "architecture",
        "testing",
        "supplychain",
        "artifactsecurity",
        "policymodule",
        "pack",
        "portability",
        "engine",
        "cli",
        "launcher",
        "tooling"
      ]
    }
  },
  "modules": [
    {
      "name": "policy",
      "paths": ["internal/policy/**"]
    },
    {
      "name": "repository",
      "paths": ["internal/repository/**"],
      "dependsOn": ["policy"]
    },
    {
      "name": "runner",
      "paths": ["internal/runner/**"],
      "dependsOn": ["policy"]
    },
    {
      "name": "gaterun",
      "paths": ["internal/gaterun/**"],
      "dependsOn": ["testreceipt"]
    },
    {
      "name": "testartifact",
      "paths": ["internal/testartifact/**"],
      "dependsOn": ["policy"]
    },
    {
      "name": "testreceipt",
      "paths": ["internal/testreceipt/**"],
      "dependsOn": ["policy", "testartifact"]
    },
    {
      "name": "finalstate",
      "paths": ["internal/finalstate/**"]
    },
    {
      "name": "behaviorreview",
      "paths": ["internal/behaviorreview/**"],
      "dependsOn": ["finalstate", "gaterun", "policy", "repository", "runner"]
    },
    {
      "name": "documentation",
      "paths": ["internal/documentation/**"]
    },
    {
      "name": "agents",
      "paths": ["AGENTS.md", "internal/agents/**", "templates/AGENTS.md"]
    },
    {
      "name": "release",
      "paths": ["internal/release/**"],
      "dependsOn": ["policy"]
    },
    {
      "name": "javascript",
      "paths": ["internal/javascript/**"],
      "dependsOn": ["release", "runner"]
    },
    {
      "name": "quality",
      "paths": ["internal/quality/**"],
      "dependsOn": ["javascript", "pack", "policy", "repository", "runner"]
    },
    {
      "name": "architecture",
      "paths": ["internal/architecture/**"],
      "dependsOn": ["javascript", "policy", "repository", "runner"]
    },
    {
      "name": "testing",
      "paths": ["internal/testing/**"],
      "dependsOn": ["policy", "repository", "runner", "testartifact"]
    },
    {
      "name": "supplychain",
      "paths": ["internal/supplychain/**"],
      "dependsOn": ["javascript", "policy", "repository", "runner"]
    },
    {
      "name": "artifactsecurity",
      "paths": ["internal/artifactsecurity/**"],
      "dependsOn": ["policy", "repository", "runner"]
    },
    {
      "name": "policymodule",
      "paths": ["internal/policymodule/**"],
      "dependsOn": ["policy", "repository", "runner"]
    },
    {
      "name": "pack",
      "paths": ["internal/pack/**"],
      "dependsOn": ["policy", "repository", "runner"]
    },
    {
      "name": "portability",
      "paths": ["internal/portability/**"],
      "dependsOn": ["policy", "repository"]
    },
    {
      "name": "engine",
      "paths": ["internal/engine/**"],
      "dependsOn": [
        "agents",
        "architecture",
        "artifactsecurity",
        "behaviorreview",
        "finalstate",
        "gaterun",
        "pack",
        "policy",
        "policymodule",
        "portability",
        "quality",
        "release",
        "repository",
        "runner",
        "supplychain",
        "testartifact",
        "testreceipt",
        "testing"
      ]
    },
    {
      "name": "cli",
      "paths": ["cmd/code-polishy/**"],
      "dependsOn": [
        "agents",
        "documentation",
        "engine",
        "finalstate",
        "pack",
        "policy",
        "release",
        "runner",
        "testing",
        "testreceipt"
      ]
    },
    {
      "name": "launcher",
      "paths": ["cmd/code-polishy-launcher/**"],
      "dependsOn": ["release", "runner"]
    },
    {
      "name": "tooling",
      "paths": [
        "bin/**",
        "release/**",
        "scripts/**",
        "skills/**",
        "templates/CLAUDE.md",
        "templates/architecture-review.md",
        "templates/behavior-review.md",
        "templates/policy-exception.md",
        "tools/**"
      ]
    }
  ],
  "checks": [
    {
      "name": "go-build",
      "provides": ["build"],
      "argv": ["./scripts/build.sh"],
      "modules": [
        "policy",
        "repository",
        "runner",
        "gaterun",
        "testartifact",
        "testreceipt",
        "finalstate",
        "behaviorreview",
        "documentation",
        "agents",
        "release",
        "javascript",
        "quality",
        "architecture",
        "testing",
        "supplychain",
        "artifactsecurity",
        "pack",
        "policymodule",
        "portability",
        "engine",
        "cli",
        "launcher",
        "tooling"
      ],
      "runOn": ["build"]
    },
    {
      "name": "javascript-bundle-lock",
      "provides": ["lock-sync"],
      "argv": ["./scripts/check-javascript-bundle.sh"],
      "runOn": ["supply-chain"]
    }
  ],
  "tests": {
    "requiredKinds": ["unit", "contract"],
    "requiredSupplementalKinds": ["mutation"],
    "suites": [
      {
        "name": "policy-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["policy"],
        "argv": ["go", "test", "-count=1", "./internal/policy/..."]
      },
      {
        "name": "repository-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["repository"],
        "argv": ["go", "test", "-count=1", "./internal/repository/..."]
      },
      {
        "name": "runner-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["runner"],
        "argv": ["go", "test", "-count=1", "./internal/runner/..."]
      },
      {
        "name": "gaterun-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["gaterun"],
        "argv": ["go", "test", "-count=1", "./internal/gaterun/..."]
      },
      {
        "name": "testartifact-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["testartifact"],
        "argv": ["go", "test", "-count=1", "./internal/testartifact/..."]
      },
      {
        "name": "testreceipt-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["testreceipt"],
        "argv": ["go", "test", "-count=1", "./internal/testreceipt/..."]
      },
      {
        "name": "finalstate-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["finalstate"],
        "argv": ["go", "test", "-count=1", "./internal/finalstate/..."]
      },
      {
        "name": "behaviorreview-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["behaviorreview"],
        "argv": ["go", "test", "-count=1", "./internal/behaviorreview/..."]
      },
      {
        "name": "documentation-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["documentation"],
        "argv": ["go", "test", "-count=1", "./internal/documentation/..."]
      },
      {
        "name": "agents-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["agents"],
        "argv": ["go", "test", "-count=1", "./internal/agents/..."]
      },
      {
        "name": "release-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["release"],
        "argv": ["go", "test", "-count=1", "./internal/release/..."]
      },
      {
        "name": "javascript-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["javascript"],
        "argv": ["go", "test", "-count=1", "./internal/javascript/..."]
      },
      {
        "name": "quality-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["quality"],
        "argv": ["go", "test", "-count=1", "./internal/quality/..."]
      },
      {
        "name": "architecture-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["architecture"],
        "argv": ["go", "test", "-count=1", "./internal/architecture/..."]
      },
      {
        "name": "testing-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["testing"],
        "argv": ["go", "test", "-count=1", "./internal/testing/..."]
      },
      {
        "name": "supplychain-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["supplychain"],
        "argv": ["go", "test", "-count=1", "./internal/supplychain/..."]
      },
      {
        "name": "artifactsecurity-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["artifactsecurity"],
        "argv": ["go", "test", "-count=1", "./internal/artifactsecurity/..."]
      },
      {
        "name": "pack-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["pack"],
        "argv": ["go", "test", "-count=1", "./internal/pack/..."]
      },
      {
        "name": "policymodule-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["policymodule"],
        "argv": ["go", "test", "-count=1", "./internal/policymodule/..."]
      },
      {
        "name": "portability-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["portability"],
        "argv": ["go", "test", "-count=1", "./internal/portability/..."]
      },
      {
        "name": "engine-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["engine"],
        "argv": ["go", "test", "-count=1", "./internal/engine/..."]
      },
      {
        "name": "cli-contract",
        "kind": "contract",
        "scope": "module",
        "modules": ["cli"],
        "argv": ["go", "test", "-count=1", "./cmd/code-polishy/..."],
        "runOn": ["focused", "recommended", "full"]
      },
      {
        "name": "launcher-contract",
        "kind": "contract",
        "scope": "module",
        "modules": ["launcher"],
        "argv": ["go", "test", "-count=1", "./cmd/code-polishy-launcher/..."],
        "runOn": ["focused", "recommended", "full"]
      },
      {
        "name": "mutation-wrapper-contract",
        "kind": "contract",
        "scope": "module",
        "modules": ["tooling"],
        "argv": ["./scripts/test-mutation-wrapper.sh"],
        "runOn": ["focused", "recommended", "full"]
      },
      {
        "name": "install-contract",
        "kind": "contract",
        "scope": "repository",
        "cost": "quick",
        "paths": [
          "scripts/install.sh",
          "scripts/build-oci-image.sh",
          "scripts/build-release.ps1",
          "scripts/build-release.sh",
          "scripts/release-manifest.sh",
          "scripts/release-version.sh",
          "scripts/test-install.sh",
          "cmd/code-polishy-launcher/**",
          "internal/release/**",
          "release/**",
          "templates/**",
          "tools/*-version.txt",
          "tools/javascript/**",
          "tools/javascript-*.sh"
        ],
        "argv": ["./scripts/test-install.sh"],
        "runOn": ["focused", "recommended", "full"]
      },
      {
        "name": "release-preflight-contract",
        "kind": "contract",
        "scope": "repository",
        "cost": "quick",
        "paths": [
          "CHANGELOG.md",
          "VERSION",
          "scripts/release-preflight.sh",
          "scripts/release-version.sh",
          "scripts/test-release-preflight.sh"
        ],
        "argv": ["./scripts/test-release-preflight.sh"],
        "runOn": ["focused", "recommended", "full"]
      },
      {
        "name": "javascript-runtime-contract",
        "kind": "contract",
        "scope": "repository",
        "cost": "quick",
        "paths": [
          "scripts/test-javascript-runtime.sh",
          "tools/install-javascript-runtime.sh",
          "tools/javascript-env.sh",
          "tools/javascript_runtime_binaries.txt",
          "tools/javascript_runtime_checksums.txt",
          "tools/node-version.txt",
          "tools/pnpm-version.txt",
          "tools/verify-sha256.sh"
        ],
        "argv": ["./scripts/test-javascript-runtime.sh"],
        "runOn": ["focused", "recommended", "full"]
      },
      {
        "name": "javascript-bundle-contract",
        "kind": "contract",
        "scope": "repository",
        "cost": "quick",
        "paths": [
          "scripts/check-javascript-bundle.sh",
          "scripts/test-javascript-bundle.sh",
          "tools/install-javascript-bundle.sh",
          "tools/javascript-bundle-manifest.sh",
          "tools/javascript-env.sh",
          "tools/javascript/**",
          "tools/javascript_bundle_inventory.txt",
          "tools/node-version.txt",
          "tools/pnpm-version.txt",
          "tools/verify-javascript-bundle-lock.sh",
          "tools/verify-javascript-bundle-tree.sh"
        ],
        "argv": ["./scripts/test-javascript-bundle.sh"],
        "runOn": ["focused", "recommended", "full"]
      },
      {
        "name": "javascript-runner-contract",
        "kind": "contract",
        "scope": "repository",
        "cost": "quick",
        "paths": [
          "internal/javascript/**",
          "scripts/javascript-runner-test-env.sh",
          "scripts/test-javascript-runner.sh",
          "tools/javascript/**",
          "tools/javascript-env.sh",
          "tools/node-version.txt",
          "tools/pnpm-version.txt"
        ],
        "argv": ["./scripts/test-javascript-runner.sh"],
        "runOn": ["focused", "recommended", "full"]
      },
      {
        "name": "javascript-project-contract",
        "kind": "contract",
        "scope": "repository",
        "cost": "quick",
        "paths": [
          "internal/javascript/**",
          "scripts/javascript-runner-test-env.sh",
          "scripts/test-javascript-project.sh",
          "tools/javascript/**",
          "tools/javascript-env.sh",
          "tools/node-version.txt",
          "tools/pnpm-version.txt"
        ],
        "argv": ["./scripts/test-javascript-project.sh"],
        "runOn": ["focused", "recommended", "full"]
      },
      {
        "name": "language-pack-contract",
        "kind": "contract",
        "scope": "repository",
        "cost": "quick",
        "paths": [
          "cmd/code-polishy/**",
          "internal/pack/**",
          "scripts/go.sh",
          "tools/fixtures/language-pack/**"
        ],
        "argv": [
          "./scripts/go.sh",
          "run",
          "./cmd/code-polishy",
          "--policy-root",
          ".",
          "pack",
          "verify",
          "--source",
          "tools/fixtures/language-pack"
        ],
        "runOn": ["focused", "recommended", "full"]
      },
      {
        "name": "repository-full",
        "kind": "contract",
        "scope": "repository",
        "cost": "standard",
        "argv": [
          "go",
          "test",
          "-count=1",
          "./cmd/code-polishy/...",
          "-run",
          "^(TestInstalledReleaseCanVerifyAReleaseTreeWithoutATargetLock|TestInstalledReleaseGovernsOnlyTheRepositoryThatLocksIt)$"
        ],
        "runOn": ["full"]
      },
      {
        "name": "policy-mutation",
        "kind": "mutation",
        "scope": "module",
        "modules": ["policy"],
        "argv": ["./scripts/go-mutation.sh", "./internal/policy"],
        "timeoutSeconds": 3600
      },
      {
        "name": "repository-mutation",
        "kind": "mutation",
        "scope": "module",
        "modules": ["repository"],
        "argv": ["./scripts/go-mutation.sh", "./internal/repository"],
        "timeoutSeconds": 3600
      },
      {
        "name": "runner-mutation",
        "kind": "mutation",
        "scope": "module",
        "modules": ["runner"],
        "argv": ["./scripts/go-mutation.sh", "./internal/runner"],
        "timeoutSeconds": 3600
      },
      {
        "name": "gaterun-mutation",
        "kind": "mutation",
        "scope": "module",
        "modules": ["gaterun"],
        "argv": ["./scripts/go-mutation.sh", "./internal/gaterun"],
        "timeoutSeconds": 3600
      },
      {
        "name": "behaviorreview-artifacts-mutation",
        "kind": "mutation",
        "scope": "module",
        "modules": ["behaviorreview"],
        "argv": [
          "./scripts/go-mutation.sh",
          "./internal/behaviorreview",
          "--exclude-files",
          "(^|/)(intent|proof|requirements|review|review_material|selection)[.]go$"
        ],
        "timeoutSeconds": 3600
      },
      {
        "name": "behaviorreview-intent-mutation",
        "kind": "mutation",
        "scope": "module",
        "modules": ["behaviorreview"],
        "argv": [
          "./scripts/go-mutation.sh",
          "./internal/behaviorreview",
          "--exclude-files",
          "(^|/)(artifact.*|checkpoint|common|final_state|proof|review|types)[.]go$"
        ],
        "timeoutSeconds": 3600
      },
      {
        "name": "behaviorreview-proof-mutation",
        "kind": "mutation",
        "scope": "module",
        "modules": ["behaviorreview"],
        "argv": [
          "./scripts/go-mutation.sh",
