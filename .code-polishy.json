        "timeoutSeconds": 3600
      },
      {
        "name": "release-mutation",
        "kind": "mutation",
        "scope": "module",
        "modules": ["release"],
        "argv": ["./scripts/go-mutation.sh", "./internal/release"],
        "timeoutSeconds": 3600
      },
      {
        "name": "javascript-mutation",
        "kind": "mutation",
        "scope": "module",
        "modules": ["javascript"],
        "argv": ["./scripts/go-mutation.sh", "./internal/javascript"],
        "timeoutSeconds": 3600
      },
      {
        "name": "quality-comments-core-mutation",
        "kind": "mutation",
        "scope": "module",
        "modules": ["quality"],
        "argv": [
          "./scripts/go-mutation.sh",
          "./internal/quality",
          "--conditionals-boundary=false",
          "--exclude-files",
          "(^|/)(comments_(python|shell|web)|javascript|markdown.*|quality)[.]go$"
        ],
        "timeoutSeconds": 3600
      },
      {
        "name": "quality-comments-python-mutation",
        "kind": "mutation",
        "scope": "module",
        "modules": ["quality"],
        "argv": [
          "./scripts/go-mutation.sh",
          "./internal/quality",
          "--conditionals-boundary=false",
          "--exclude-files",
