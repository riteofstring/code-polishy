        "kind": "mutation",
        "scope": "module",
        "modules": ["policymodule"],
        "argv": ["./scripts/go-mutation.sh", "./internal/policymodule"],
        "timeoutSeconds": 3600
      },
      {
        "name": "portability-mutation",
        "kind": "mutation",
        "scope": "module",
        "modules": ["portability"],
        "argv": [
          "./scripts/go-mutation.sh",
          "./internal/portability",
          "--timeout-coefficient",
          "7"
        ],
        "timeoutSeconds": 3600
      },
      {
        "name": "engine-mutation",
        "kind": "mutation",
        "scope": "module",
        "modules": ["engine"],
        "argv": ["./scripts/go-mutation.sh", "./internal/engine"],
        "timeoutSeconds": 3600
      },
      {
        "name": "cli-mutation",
        "kind": "mutation",
        "scope": "module",
        "modules": ["cli"],
        "argv": ["./scripts/go-mutation.sh", "./cmd/code-polishy"],
        "timeoutSeconds": 3600
