          "--exclude-files",
          "(^|/)(artifact.*|checkpoint|common|final_state|intent|requirements|review_material|selection|types)[.]go$"
        ],
        "timeoutSeconds": 3600
      },
      {
        "name": "documentation-mutation",
        "kind": "mutation",
        "scope": "module",
        "modules": ["documentation"],
        "argv": ["./scripts/go-mutation.sh", "./internal/documentation"],
        "timeoutSeconds": 3600
      },
      {
        "name": "agents-mutation",
        "kind": "mutation",
        "scope": "module",
        "modules": ["agents"],
