        "modules": ["portability"],
        "argv": ["go", "test", "-count=1", "./internal/portability/..."]
      },
      {
        "name": "engine-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["engine"],
        "argv": ["go", "test", "-count=1", "./internal/engine/..."]
      },
      {
        "name": "cli-contract",
        "kind": "contract",
        "scope": "module",
        "modules": ["cli"],
        "argv": ["go", "test", "-count=1", "./cmd/code-polishy/..."],
        "runOn": ["focused", "recommended", "full"]
      },
      {
        "name": "launcher-contract",
        "kind": "contract",
        "scope": "module",
        "modules": ["launcher"],
        "argv": ["go", "test", "-count=1", "./cmd/code-polishy-launcher/..."],
        "runOn": ["focused", "recommended", "full"]
      },
      {
        "name": "tooling-contract",
        "kind": "contract",
        "scope": "module",
        "modules": ["tooling"],
        "argv": ["./scripts/test-tooling.sh"],
        "runOn": ["focused", "recommended", "full"]
      },
      {
        "name": "repository-full",
        "kind": "contract",
        "scope": "repository",
        "cost": "standard",
        "argv": ["go", "test", "-count=1", "./..."],
        "runOn": ["full"]
      },
      {
        "name": "policy-mutation",
        "kind": "mutation",
        "scope": "module",
        "cost": "expensive",
        "modules": ["policy"],
        "argv": ["./scripts/go-mutation.sh", "./internal/policy"],
        "runOn": ["supplemental"],
        "timeoutSeconds": 3600
      },
      {
