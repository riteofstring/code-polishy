{
  "$schema": "schema/code-polishy.schema.json",
  "version": 4,
  "project": {
    "kind": "tooling",
    "capabilities": ["cli"]
  },
  "scope": {
    "data": [
      "internal/spdx/data/exceptions.json",
      "internal/spdx/data/licenses.json"
    ],
    "generated": ["internal/engine/testdata/**", "schema/sarif*.json"],
    "entryPoints": [
      "tools/javascript/bundle-manifest.mjs",
      "tools/javascript/runner.mjs"
    ]
  },
  "documentation": {
    "design": [
      {
        "path": "docs/design/agent-guidance.md",
        "module": "agents"
      },
      {
        "path": "docs/design/python-contract-evidence.md",
        "sourcePaths": [
          "internal/repository/python_plugins.go",
          "internal/repository/python_distribution_sources.go",
          "internal/repository/python_distribution_origin.go",
          "internal/repository/python_reachability.go",
          "internal/repository/python_reachability_contract.go",
          "internal/repository/python_reachability_state.go",
          "internal/pythonfacts/contract_definitions.go",
          "internal/pythonfacts/contract_definitions.py",
          "internal/pythonfacts/external_contracts.py",
          "internal/pythonfacts/reachability_validation.go",
          "internal/engine/python_reachability_state.go"
        ]
      },
      {
        "path": "docs/design/design-context.md",
        "sourcePaths": [
          "internal/repository/design_context.go",
          "internal/repository/selection.go",
          "internal/engine/design_context.go",
          "internal/engine/task_start.go",
          "internal/engine/task_start_actions.go",
          "cmd/code-polishy/design_context.go"
        ]
      },
      {
        "path": "docs/design/installed-release-verification.md",
        "sourcePaths": [
          "scripts/test-installed-release.sh",
          "scripts/test-installed-release-contract.sh",
          "scripts/test-installed-release-architecture.sh"
        ]
      },
      {
        "path": "docs/design/historical-review-policy.md",
        "sourcePaths": [
          "internal/policy/review_snapshot.go",
          "internal/engine/behavior_review_decision.go",
          "internal/engine/merge_gate.go"
        ]
      }
    ]
  },
  "verification": {
    "finalGateOwner": "local",
    "mergeGate": {
      "recommendedModules": [
        "policy",
        "spdx",
        "pythonfacts",
        "repository",
        "runner",
        "gaterun",
        "finalstate",
        "behaviorreview",
        "documentation",
        "agents",
        "release",
        "javascript",
        "quality",
        "architecture",
        "testing",
        "supplychain",
        "workflow",
        "artifactsecurity",
        "policymodule",
        "pack",
        "portability",
        "engine",
        "cli",
        "launcher",
        "tooling"
      ]
    }
  },
  "modules": [
    {
      "name": "spdx",
      "paths": ["internal/spdx/**"]
    },
    {
      "name": "pythonfacts",
      "paths": ["internal/pythonfacts/**"]
    },
    {
      "name": "policy",
      "paths": ["internal/policy/**", "schema/**"],
      "dependsOn": ["spdx"]
    },
    {
      "name": "repository",
      "paths": ["internal/repository/**"],
      "dependsOn": ["policy", "pythonfacts"]
    },
    {
      "name": "runner",
      "paths": ["internal/runner/**"],
      "dependsOn": ["policy"]
    },
    {
      "name": "gaterun",
      "paths": ["internal/gaterun/**"],
      "dependsOn": ["architecture", "policy", "testreceipt"]
    },
    {
      "name": "testartifact",
      "paths": ["internal/testartifact/**"],
      "dependsOn": ["policy"]
    },
    {
      "name": "testreceipt",
      "paths": ["internal/testreceipt/**"],
      "dependsOn": ["policy", "testartifact"]
    },
    {
      "name": "finalstate",
      "paths": ["internal/finalstate/**"]
    },
    {
      "name": "behaviorreview",
      "paths": ["internal/behaviorreview/**"],
      "dependsOn": [
        "architecture",
        "finalstate",
        "gaterun",
        "policy",
        "repository",
        "runner"
      ]
    },
    {
      "name": "documentation",
      "paths": ["internal/documentation/**"]
    },
    {
      "name": "agents",
      "paths": ["AGENTS.md", "internal/agents/**", "templates/AGENTS.md"]
    },
    {
      "name": "release",
      "paths": ["internal/release/**"],
      "dependsOn": ["policy", "pythonfacts"]
    },
    {
      "name": "javascript",
      "paths": ["internal/javascript/**"],
      "dependsOn": ["release", "runner"]
    },
    {
      "name": "quality",
      "paths": ["internal/quality/**"],
      "dependsOn": [
        "javascript",
        "pack",
        "policy",
        "pythonfacts",
        "repository",
        "runner"
      ]
    },
    {
      "name": "architecture",
      "paths": ["internal/architecture/**"],
      "dependsOn": [
        "javascript",
        "policy",
        "pythonfacts",
        "repository",
        "runner"
      ]
    },
    {
      "name": "testing",
      "paths": ["internal/testing/**"],
      "dependsOn": ["policy", "repository", "runner", "testartifact"]
    },
    {
      "name": "supplychain",
      "paths": ["internal/supplychain/**"],
      "dependsOn": [
        "javascript",
        "policy",
        "repository",
        "runner",
        "spdx",
        "workflow"
      ]
    },
    {
      "name": "workflow",
      "paths": ["internal/workflow/**"]
    },
    {
      "name": "artifactsecurity",
      "paths": ["internal/artifactsecurity/**"],
      "dependsOn": ["policy", "repository", "runner"]
    },
    {
      "name": "policymodule",
      "paths": ["internal/policymodule/**"],
      "dependsOn": ["policy", "repository", "runner"]
    },
    {
      "name": "pack",
      "paths": ["internal/pack/**"],
      "dependsOn": ["policy", "repository", "runner"]
    },
    {
      "name": "portability",
      "paths": ["internal/portability/**"],
      "dependsOn": ["policy", "repository"]
    },
    {
      "name": "engine",
      "paths": ["internal/engine/**"],
      "dependsOn": [
        "agents",
        "architecture",
        "artifactsecurity",
        "behaviorreview",
        "finalstate",
        "gaterun",
        "pack",
        "policy",
        "spdx",
        "pythonfacts",
        "policymodule",
        "portability",
        "quality",
        "release",
        "repository",
        "runner",
        "supplychain",
        "workflow",
        "testartifact",
        "testreceipt",
        "testing"
      ]
    },
    {
      "name": "cli",
      "paths": ["cmd/code-polishy/**"],
      "dependsOn": [
        "agents",
        "documentation",
        "engine",
        "finalstate",
        "pack",
        "policy",
        "release",
        "runner",
        "testing",
        "testreceipt"
      ]
    },
    {
      "name": "launcher",
      "paths": ["cmd/code-polishy-launcher/**"],
      "dependsOn": ["release", "runner"]
    },
    {
      "name": "tooling",
      "paths": [
        "bin/**",
        "release/**",
        "scripts/**",
        "skills/**",
        "templates/CLAUDE.md",
        "templates/architecture-review.md",
        "templates/behavior-review.md",
        "templates/policy-exception.md",
        "tools/**"
      ]
    }
  ],
  "checks": [
    {
      "name": "go-build",
      "provides": ["build"],
      "argv": ["./scripts/build.sh"],
      "modules": [
        "policy",
        "spdx",
        "pythonfacts",
        "repository",
        "runner",
        "gaterun",
        "testartifact",
        "testreceipt",
        "finalstate",
        "behaviorreview",
        "documentation",
        "agents",
        "release",
        "javascript",
        "quality",
        "architecture",
        "testing",
        "supplychain",
        "workflow",
        "artifactsecurity",
        "pack",
        "policymodule",
        "portability",
        "engine",
        "cli",
        "launcher",
        "tooling"
      ],
      "runOn": ["build"]
    },
    {
      "name": "javascript-bundle-lock",
      "provides": ["lock-sync"],
      "argv": ["./scripts/check-javascript-bundle.sh"],
      "runOn": ["supply-chain"]
    },
    {
      "name": "python-facts-lock",
      "provides": ["lock-sync"],
      "argv": ["./scripts/check-python-facts-lock.sh"],
      "modules": ["pythonfacts"],
      "runOn": ["supply-chain"]
    }
  ],
  "tests": {
    "requiredKinds": ["unit", "contract"],
    "requiredSupplementalKinds": ["mutation"],
    "suites": [
      {
        "name": "spdx-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["spdx"],
        "argv": ["go", "test", "-count=1", "./internal/spdx/..."],
        "paths": ["internal/spdx/**/*_test.go"]
      },
      {
        "name": "pythonfacts-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["pythonfacts"],
        "argv": ["go", "test", "-count=1", "./internal/pythonfacts/..."],
        "paths": ["internal/pythonfacts/**/*_test.go"]
      },
      {
        "name": "policy-unit",
        "kind": "unit",
        "scope": "module",
        "modules": ["policy"],
        "argv": ["go", "test", "-count=1", "./internal/policy/..."],
