# npm-compatible settings for the policy-owned JavaScript tool bundle. pnpm's
# own settings live in pnpm-workspace.yaml; this file exists so the registry
# origin is pinned in the bundle itself rather than inherited from whatever
# ambient configuration a host happens to have.
#
# Acquisition additionally runs with a scratch HOME and with the user and
# global npmrc paths pointed at absent files, so no host configuration can add
# a registry, scope, proxy, or credential to what is installed.
registry=https://registry.npmjs.org/
