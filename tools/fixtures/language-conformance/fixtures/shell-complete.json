{
  "$schema": "https://raw.githubusercontent.com/riteofstring/code-polishy/main/schema/code-polishy-language-conformance-fixture-v1.schema.json",
  "protocol": "language-conformance-fixture/v1",
  "id": "shell-complete",
  "maturity": "planned",
  "gap": "Capture extensions, shebangs, Bash and POSIX dialects, syntax, ShellCheck, directives, heredocs, quoting, substitutions, portability, configured checks, explicit formatting absence, and unavailable platform behavior.",
  "behaviorIds": [
    "shell.discovery.extensions-shebangs-dialects",
    "shell.quality.syntax-shellcheck",
    "shell.quality.comments-directives",
    "shell.quality.format-absence",
    "shell.portability.facts",
    "shell.execution.tool-platform-failure"
  ],
  "files": [
    {
      "path": ".code-polishy.json",
      "mode": "0644",
      "content": "{\"version\":4,\"project\":{\"kind\":\"application\",\"capabilities\":[]},\"modules\":[{\"name\":\"tooling\",\"paths\":[\"scripts/**\"]}],\"tests\":{\"ownership\":[],\"suites\":[]}}\n"
    },
    {
      "path": "scripts/example.sh",
      "mode": "0755",
      "content": "#!/usr/bin/env bash\nvalue=$1\necho $value\n"
    },
    {
      "path": "scripts/portable",
      "mode": "0755",
      "content": "#!/bin/sh\nprintf '%s\\n' \"$1\"\n"
    }
  ],
  "arguments": ["check", "--all", "--format", "json"],
  "timeoutSeconds": 900,
  "platforms": [
    "darwin-amd64",
    "darwin-arm64",
    "linux-amd64",
    "linux-arm64",
    "windows-amd64"
  ],
  "expected": {
    "exitStatus": 1,
    "reportStatus": "failed",
    "requiredRules": ["quality.shellcheck"],
    "requiredCoverage": ["scripts/example.sh", "scripts/portable"],
    "writes": [],
    "protected": [
      ".code-polishy.json",
      "scripts/example.sh",
      "scripts/portable"
    ]
  }
}
