{
  "$schema": "https://raw.githubusercontent.com/riteofstring/code-polishy/main/schema/code-polishy-language-conformance-fixture-v1.schema.json",
  "protocol": "language-conformance-fixture/v1",
  "id": "python-discovery-quality",
  "maturity": "planned",
  "gap": "Split static root, nested, source-layout, interpreter, project-local environment, Ruff format/lint/complexity, ty, Vulture, docstring, and source-fact behavior into positive and seeded-defect cases.",
  "behaviorIds": [
    "python.discovery.projects-layouts",
    "python.discovery.interpreter-environment",
    "python.quality.format-lint-complexity",
    "python.quality.typecheck",
    "python.quality.dead-code",
    "python.quality.comments-docstrings",
    "python.facts.static-analysis"
  ],
  "files": [
    {
      "path": ".code-polishy.json",
      "mode": "0644",
      "content": "{\"version\":4,\"project\":{\"kind\":\"application\",\"capabilities\":[]},\"modules\":[{\"name\":\"application\",\"paths\":[\"src/**\"]}],\"tests\":{\"ownership\":[],\"suites\":[]}}\n"
    },
    {
      "path": "pyproject.toml",
      "mode": "0644",
      "content": "[project]\nname = \"conformance\"\nversion = \"1.0.0\"\nrequires-python = \"==3.12.*\"\n"
    },
    {
      "path": "src/conformance/__init__.py",
      "mode": "0644",
      "content": "def unused( value ):\n    return value\n"
    }
  ],
  "arguments": ["check", "--all", "--format", "json"],
  "timeoutSeconds": 900,
  "platforms": [
    "darwin-amd64",
    "darwin-arm64",
    "linux-amd64",
    "linux-arm64",
    "windows-amd64"
  ],
  "expected": {
    "exitStatus": 1,
    "reportStatus": "failed",
    "requiredRules": ["quality.format"],
    "requiredCoverage": ["src/conformance/__init__.py"],
    "writes": [],
    "protected": [
      ".code-polishy.json",
      "pyproject.toml",
      "src/conformance/__init__.py"
    ]
  }
}
