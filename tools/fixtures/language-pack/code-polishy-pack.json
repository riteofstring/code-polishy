{
  "$schema": "../../../schema/code-polishy-pack.schema.json",
  "manifestVersion": 2,
  "name": "sqlite-syntax-proof",
  "version": "1.0.0",
  "protocolVersion": 3,
  "platforms": ["darwin-amd64", "darwin-arm64", "linux-amd64", "linux-arm64"],
  "languages": [
    {
      "id": "sql",
      "sourcePatterns": ["**/*.fixture"]
    }
  ],
  "commands": [
    {
      "name": "adapter",
      "argv": ["bin/adapter"],
      "capabilities": ["lint"],
      "profiles": ["check", "gate"],
      "timeoutSeconds": 30,
      "runtime": {
        "name": "node",
        "version": "24.18.0"
      }
    }
  ],
  "fixtures": [
    {
      "name": "lint-pass",
      "command": "adapter",
      "capability": "lint",
      "project": "fixtures/pass",
      "files": ["src/main.fixture"],
      "expectedStatus": "pass"
    },
    {
      "name": "lint-fail",
      "command": "adapter",
      "capability": "lint",
      "project": "fixtures/fail",
      "files": ["src/main.fixture"],
      "expectedStatus": "findings",
      "expectedRules": ["sql-syntax"]
    }
  ]
}
