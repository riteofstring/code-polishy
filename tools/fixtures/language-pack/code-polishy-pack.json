{
  "$schema": "../../../schema/code-polishy-pack.schema.json",
  "manifestVersion": 3,
  "name": "sqlite-syntax-proof",
  "version": "1.0.0",
  "engineVersion": "0.27.10",
  "protocolVersion": 4,
  "platforms": ["darwin-amd64", "darwin-arm64", "linux-amd64", "linux-arm64"],
  "languages": [
    {
      "id": "sql",
      "sourcePatterns": ["**/*.fixture"],
      "discoveryMode": "file-scoped",
      "unsupportedCapabilities": [
        {
          "capability": "format",
          "reason": "this syntax proof does not specify a formatter"
        }
      ]
    }
  ],
  "commands": [
    {
      "name": "adapter",
      "argv": ["bin/adapter"],
      "languages": ["sql"],
      "capabilities": ["lint"],
      "profiles": ["check", "gate"],
      "activation": "selected",
      "timeoutSeconds": 30,
      "execution": {
        "type": "host-toolchain",
        "network": "none",
        "tools": [
          {
            "id": "node",
            "name": "node",
            "version": "24.18.0",
            "launcher": true
          }
        ]
      }
    }
  ],
  "fixtures": [
    {
      "name": "lint-pass",
      "command": "adapter",
      "capability": "lint",
      "project": "fixtures/pass",
      "files": ["src/main.fixture"],
      "expectedStatus": "pass"
    },
    {
      "name": "lint-fail",
      "command": "adapter",
      "capability": "lint",
      "project": "fixtures/fail",
      "files": ["src/main.fixture"],
      "expectedStatus": "findings",
      "expectedRules": ["sql-syntax"]
    }
  ]
}
