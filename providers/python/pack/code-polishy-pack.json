{
  "$schema": "https://raw.githubusercontent.com/riteofstring/code-polishy/main/schema/code-polishy-pack.schema.json",
  "manifestVersion": 3,
  "name": "python",
  "version": "0.27.10",
  "engineVersion": "0.27.10",
  "protocolVersion": 4,
  "platforms": [
    "darwin-amd64",
    "darwin-arm64",
    "linux-amd64",
    "linux-arm64",
    "windows-amd64"
  ],
  "executables": [
    "bin/adapter-darwin-amd64",
    "bin/adapter-darwin-arm64",
    "bin/adapter-linux-amd64",
    "bin/adapter-linux-arm64",
    "bin/adapter-windows-amd64.exe"
  ],
  "languages": [
    {
      "id": "python",
      "sourcePatterns": ["**/*.py", "**/*.pyi"],
      "testPatterns": ["**/test_*.py", "**/*_test.py", "**/tests/**/*.py"],
      "discoveryMode": "static",
      "metadataPatterns": ["**/.ruff.toml", "**/pyproject.toml", "**/ruff.toml"]
    }
  ],
  "commands": [
    {
      "name": "format",
      "argv": ["bin/adapter"],
      "languages": ["python"],
      "capabilities": ["format"],
      "profiles": ["check", "gate", "format"],
      "activation": "selected",
      "timeoutSeconds": 300,
      "execution": {
        "type": "host-toolchain",
        "network": "none",
        "tools": [
          {
            "id": "node",
            "name": "node",
            "version": "24.18.0",
            "launcher": true
          },
          {
            "id": "python",
            "name": "python",
            "version": "3.12.13+20260728"
          },
          {
            "id": "ruff",
            "name": "ruff",
            "version": "0.16.0"
          }
        ]
      }
    },
    {
      "name": "analyze",
      "argv": ["bin/adapter"],
      "languages": ["python"],
      "capabilities": ["lint", "complexity", "architecture"],
      "profiles": ["check", "gate"],
      "activation": "selected",
      "timeoutSeconds": 300,
      "execution": {
        "type": "host-toolchain",
        "network": "none",
        "tools": [
          {
            "id": "node",
            "name": "node",
            "version": "24.18.0",
            "launcher": true
          },
          {
            "id": "python",
            "name": "python",
            "version": "3.12.13+20260728"
          },
          {
            "id": "ruff",
            "name": "ruff",
            "version": "0.16.0"
          }
        ]
      }
    },
    {
      "name": "typecheck",
      "argv": ["bin/adapter"],
      "languages": ["python"],
      "capabilities": ["typecheck"],
      "profiles": ["check", "gate"],
      "activation": "selected",
      "timeoutSeconds": 300,
      "execution": {
        "type": "host-toolchain",
        "network": "none",
        "tools": [
          {
            "id": "node",
            "name": "node",
            "version": "24.18.0",
            "launcher": true
          },
          {
            "id": "python",
            "name": "python",
            "version": "3.12.13+20260728"
          },
          {
            "id": "ty",
            "name": "ty",
            "version": "0.0.65"
          }
        ]
      }
    },
    {
      "name": "dead-code",
      "argv": ["bin/adapter"],
      "languages": ["python"],
      "capabilities": ["dead-code"],
      "profiles": ["check", "gate"],
      "activation": "complete-or-gate",
      "timeoutSeconds": 300,
      "execution": {
        "type": "host-toolchain",
        "network": "none",
        "tools": [
          {
            "id": "node",
            "name": "node",
            "version": "24.18.0",
            "launcher": true
          },
          {
            "id": "python",
            "name": "python",
            "version": "3.12.13+20260728"
          }
        ]
      }
    }
  ],
