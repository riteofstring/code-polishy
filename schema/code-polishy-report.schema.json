{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-polishy.dev/schema/code-polishy-report.schema.json",
  "title": "Code Polishy report",
  "type": "object",
  "required": [
    "$schema",
    "protocol",
    "command",
    "reportPath",
    "analysisContext",
    "summary",
    "testCommands",
    "testDiagnostics",
    "testAggregations",
    "findings",
    "suppressed",
    "vulnerabilityAssessments",
    "releaseAgeAssessments",
    "tables",
    "notes"
  ],
  "properties": {
    "$schema": {
      "const": "https://code-polishy.dev/schema/code-polishy-report.schema.json"
    },
    "protocol": { "const": "code-polishy-report/v1" },
    "command": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "reportPath": { "type": "string" },
    "requestedSelection": { "$ref": "#/$defs/requestedSelection" },
    "analysisContext": {
      "type": "array",
      "items": { "$ref": "#/$defs/analysisContext" }
    },
    "sourceDependencyGraph": { "$ref": "#/$defs/sourceDependencyGraph" },
    "repositoryContext": { "$ref": "#/$defs/repositoryContext" },
    "architectureReview": { "$ref": "#/$defs/architectureReview" },
    "architecturePreparation": {
      "type": "object",
      "required": [
        "reviewId",
        "base",
        "candidate",
        "topology",
        "packetPath",
        "resultPath"
      ],
      "properties": {
        "reviewId": { "type": "string", "minLength": 1 },
        "base": { "type": "string", "minLength": 40 },
        "candidate": { "type": "string", "minLength": 40 },
        "topology": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "packetPath": { "type": "string", "minLength": 1 },
        "resultPath": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "summary": { "$ref": "#/$defs/summary" },
    "display": { "$ref": "#/$defs/display" },
    "testCommands": { "type": "array", "items": { "type": "object" } },
    "testDiagnostics": { "type": "array", "items": { "type": "object" } },
    "testAggregations": { "type": "array", "items": { "type": "object" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "suppressed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "exception"],
        "properties": {
          "finding": { "$ref": "#/$defs/finding" },
          "exception": { "type": "object" }
        }
      }
    },
    "vulnerabilityAssessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "assessment"],
        "properties": {
          "finding": { "$ref": "#/$defs/finding" },
          "assessment": { "type": "object" }
        }
      }
    },
    "releaseAgeAssessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "assessment"],
        "properties": {
          "finding": { "$ref": "#/$defs/finding" },
          "assessment": { "type": "object" }
        }
      }
    },
    "tables": { "type": "array", "items": { "type": "object" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "formatting": { "$ref": "#/$defs/formatting" },
    "gitEvidence": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "scope",
          "provider",
          "path",
          "sha256",
          "policySha256",
          "lockSha256",
          "inventorySha256",
          "expiresAt",
          "retrievedAt"
        ],
        "properties": {
          "scope": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "lockSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "inventorySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "retrievedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "designResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedModules",
        "selectedPathCount",
        "matches",
        "unmappedModules",
        "unmappedPaths"
      ],
      "properties": {
        "selectedModules": {
          "$ref": "#/$defs/stringArray"
        },
        "selectedPathCount": {
          "type": "integer",
          "minimum": 0
        },
        "matches": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reasons"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "reasons": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "value"],
                  "properties": {
                    "kind": {
                      "enum": ["module", "source"]
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "unmappedModules": {
          "$ref": "#/$defs/stringArray"
        },
        "unmappedPaths": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "repositoryContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "situations",
        "designDocuments",
        "handoffs",
        "designResolution"
      ],
      "properties": {
        "protocol": { "const": "repository-context/v1" },
        "designResolution": { "$ref": "#/$defs/designResolution" },
        "situations": { "$ref": "#/$defs/stringArray", "maxItems": 33 },
        "designDocuments": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/contextDocument" }
        },
        "handoffs": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/operationalHandoff" }
        }
      }
    },
    "contextDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "content"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "content": { "type": "string", "minLength": 1, "maxLength": 1048576 }
      }
    },
    "operationalHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "document", "reasons"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 },
        "document": { "$ref": "#/$defs/contextDocument" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 192,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": {
              "kind": { "enum": ["source", "module", "situation"] },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "architectureReview": {
      "type": "object",
      "required": ["state", "base", "candidate", "topology", "signals"],
      "properties": {
        "state": { "enum": ["required", "passed", "not-required"] },
        "base": { "type": "string", "minLength": 40 },
        "candidate": { "type": "string", "minLength": 40 },
        "topology": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reviewId": { "type": "string", "minLength": 1 },
        "receiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reason": { "type": "string" },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "summary", "paths", "units"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "module": { "type": "string" },
              "summary": { "type": "string", "minLength": 1 },
              "paths": { "$ref": "#/$defs/stringArray" },
              "units": { "$ref": "#/$defs/stringArray" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "requestedSelection": {
      "type": "object",
      "required": ["mode", "operands", "expanded"],
      "properties": {
        "mode": { "type": "string" },
        "operands": { "$ref": "#/$defs/stringArray" },
        "modules": { "$ref": "#/$defs/stringArray" },
        "expanded": { "$ref": "#/$defs/stringArray" }
      }
    },
    "analysisContext": {
      "type": "object",
      "required": ["analyzer", "root", "reason", "paths"],
      "properties": {
        "analyzer": { "type": "string", "minLength": 1 },
        "root": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 },
        "paths": { "$ref": "#/$defs/stringArray" }
      }
    },
    "sourceDependencyGraph": {
      "type": "object",
      "required": [
        "protocol",
        "identity",
        "nodes",
        "edges",
        "inputs",
        "externalCompositions"
      ],
      "properties": {
        "protocol": { "const": "source-dependency-graph/v1" },
        "identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "nodes": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/dependencyNode" }
        },
        "edges": {
          "type": "array",
          "maxItems": 500000,
          "items": { "$ref": "#/$defs/dependencyEdge" }
        },
        "inputs": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/dependencyFactInput" }
        },
        "externalCompositions": {
          "type": "array",
          "maxItems": 500000,
          "items": { "$ref": "#/$defs/externalComposition" }
        }
      }
    },
    "dependencyNode": {
      "type": "object",
      "required": [
        "path",
        "language",
        "generated",
        "test",
        "root",
        "module",
        "resolutionUnit"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "language": { "enum": ["go", "python", "typescript"] },
        "generated": { "type": "boolean" },
        "test": { "type": "boolean" },
        "root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "module": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "resolutionUnit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "dependencyEdge": {
      "type": "object",
      "required": [
        "source",
        "target",
        "sourceResolutionUnit",
        "targetResolutionUnit",
        "line",
        "column",
        "ecosystem",
        "kind"
      ],
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "target": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sourceResolutionUnit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "targetResolutionUnit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "ecosystem": { "enum": ["go", "javascript", "python"] },
        "kind": {
          "enum": ["runtime", "type-only", "re-export", "proven-dynamic"]
        }
      }
    },
    "dependencyComponent": {
      "type": "object",
      "required": [
        "protocol",
        "classification",
        "identity",
        "members",
        "edges",
        "witness"
      ],
      "properties": {
        "protocol": { "const": "source-dependency-component/v1" },
        "classification": { "enum": ["production", "generated", "test-only"] },
        "identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/dependencyNode" }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500000,
          "items": { "$ref": "#/$defs/dependencyEdge" }
        },
        "witness": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/dependencyEdge" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "status",
        "errors",
        "warnings",
        "information",
        "suppressed",
        "reviewed",
        "bySelectionRelation",
        "byRule",
        "byModule"
      ],
      "properties": {
        "status": { "enum": ["passed", "failed", "review-required"] },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "information": { "type": "integer", "minimum": 0 },
        "suppressed": { "type": "integer", "minimum": 0 },
        "reviewed": { "type": "integer", "minimum": 0 },
        "bySelectionRelation": { "$ref": "#/$defs/counts" },
        "byRule": { "$ref": "#/$defs/counts" },
        "byModule": { "$ref": "#/$defs/counts" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "display": {
      "type": "object",
      "required": ["filters", "total", "displayed", "omitted"],
      "properties": {
        "filters": {
          "type": "object",
          "properties": {
            "rules": { "$ref": "#/$defs/stringArray" },
            "modules": { "$ref": "#/$defs/stringArray" },
            "paths": { "$ref": "#/$defs/stringArray" },
            "relations": {
              "type": "array",
              "items": { "$ref": "#/$defs/selectionRelation" }
            }
          }
        },
        "groupBy": { "enum": ["rule", "module", "path", "relation"] },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "total": { "type": "integer", "minimum": 0 },
        "displayed": { "type": "integer", "minimum": 0 },
        "omitted": { "type": "integer", "minimum": 0 }
      }
    },
    "selectionRelation": {
      "enum": ["selected", "related", "context", "global"]
    },
    "location": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 },
        "message": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "ruleId",
        "fingerprint",
        "severity",
        "status",
        "scope",
        "selectionRelation",
        "path",
        "subject",
        "message",
        "remediation"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)+$"
        },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "semanticIdentity": { "$ref": "#/$defs/stringArray" },
        "severity": { "enum": ["error", "warning", "information"] },
        "status": { "enum": ["open", "suppressed", "reviewed"] },
        "scope": {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": {
              "enum": [
                "repository",
                "module",
                "path",
                "dependency",
                "graph-component"
              ]
            },
            "value": { "type": "string" }
          }
        },
        "selectionRelation": { "$ref": "#/$defs/selectionRelation" },
        "selectionEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["selected", "related", "kind"],
            "properties": {
              "selected": { "$ref": "#/$defs/location" },
              "related": { "$ref": "#/$defs/location" },
              "kind": { "type": "string", "minLength": 1 }
            }
          }
        },
        "path": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endColumn": { "type": "integer", "minimum": 1 },
        "module": { "type": "string" },
        "subject": { "type": "string" },
        "relatedLocations": {
          "type": "array",
          "items": { "$ref": "#/$defs/location" }
        },
        "fields": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "generatedProducer": { "type": "string" },
        "dependencyComponent": { "$ref": "#/$defs/dependencyComponent" },
        "message": { "type": "string", "minLength": 1 },
        "remediation": {
          "type": "object",
          "required": ["summary"],
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "replacement": { "type": "string" },
            "configuration": {},
            "nextCommand": {
              "type": "object",
              "required": ["argv", "cwd"],
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 256,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "cwd": { "type": "string" }
              }
            },
            "generation": { "$ref": "#/$defs/generationRemediation" }
          }
        }
      }
    },
    "formatting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rewritten", "unchanged", "protected", "files"],
      "properties": {
        "rewritten": { "type": "integer", "minimum": 0 },
        "unchanged": { "type": "integer", "minimum": 0 },
        "protected": { "type": "integer", "minimum": 0 },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "state", "styleExempt"],
            "properties": {
              "path": { "type": "string" },
              "state": {
                "enum": [
                  "rewritten",
                  "unchanged",
                  "protected",
                  "modified-protected",
                  "unavailable"
                ]
              },
              "producer": { "type": "string", "minLength": 1 },
              "styleExempt": { "type": "boolean" }
            }
          }
        }
      }
    },
    "generationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd", "timeoutSeconds"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "cwd": { "type": "string" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "environment": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "maxLength": 4096
          }
        }
      }
    },
    "generationRemediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "inputs", "generate", "verify", "prerequisites"],
      "properties": {
        "producer": { "type": "string", "minLength": 1, "maxLength": 128 },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8192,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "generate": { "$ref": "#/$defs/generationCommand" },
        "verify": { "$ref": "#/$defs/generationCommand" },
        "prerequisites": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "message"],
            "properties": {
              "operation": { "enum": ["generate", "verify"] },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "dependencyFactInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyzer",
        "protocol",
        "project",
        "root",
        "paths",
        "factsSha256",
        "partitionsSha256",
        "resolutionSha256"
      ],
      "properties": {
        "analyzer": { "const": "python-facts" },
        "protocol": { "const": "python-facts/v3" },
        "project": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "factsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "partitionsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "resolutionSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "externalComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sourceResolutionUnit",
        "line",
        "column",
        "dependency",
        "contract"
      ],
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sourceResolutionUnit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "dependency": { "$ref": "#/$defs/externalDependency" },
        "contract": { "$ref": "#/$defs/externalContract" }
      }
    },
    "externalDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "lock",
        "manifestSha256",
        "lockSha256",
        "distribution",
        "version",
        "kind",
        "source",
        "namespace"
      ],
      "properties": {
        "project": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "lock": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "lockSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "distribution": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "kind": { "enum": ["registry", "git"] },
