{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/riteofstring/code-polishy/main/schema/code-polishy-pack-request-v4.schema.json",
  "title": "Code Polishy language pack request protocol v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "inventory",
    "selection",
    "scopes",
    "diagnosticFiles",
    "writeFiles",
    "protocolVersion",
    "operation",
    "capability",
    "projectRoot",
    "files",
    "modules",
    "mode",
    "profile",
    "context",
    "policy",
    "tools",
    "complete",
    "pack"
  ],
  "properties": {
    "provider": { "$ref": "#/$defs/nonempty" },
    "inventory": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/inventoryEntry" }
    },
    "selection": { "$ref": "#/$defs/selection" },
    "scopes": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/scope" }
    },
    "diagnosticFiles": { "$ref": "#/$defs/paths" },
    "writeFiles": { "$ref": "#/$defs/paths" },
    "protocolVersion": { "const": 4 },
    "operation": { "enum": ["discover", "check", "format"] },
    "capability": { "$ref": "#/$defs/identifier" },
    "projectRoot": { "$ref": "#/$defs/nonempty" },
    "files": {
      "allOf": [{ "$ref": "#/$defs/paths" }],
      "maxItems": 100000
    },
    "modules": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/module" }
    },
    "mode": { "enum": ["check", "write"] },
    "profile": { "$ref": "#/$defs/identifier" },
    "outputDirectory": { "$ref": "#/$defs/path" },
    "context": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/input" }
    },
    "policy": { "$ref": "#/$defs/policy" },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tool" }
    },
    "complete": { "type": "boolean" },
    "pack": { "$ref": "#/$defs/pack" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "nonempty": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).*\\S.*$"
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "deleted", "complete"],
      "properties": {
        "paths": { "$ref": "#/$defs/paths" },
        "deleted": { "$ref": "#/$defs/paths" },
        "complete": { "type": "boolean" }
      }
    },
    "inventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "modules",
        "source",
        "metadata",
        "dependency",
        "asset",
        "test",
        "generated",
        "data",
        "development",
        "control"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "language": { "$ref": "#/$defs/identifier" },
        "context": { "$ref": "#/$defs/path" },
        "owner": { "type": "string" },
        "modules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "source": { "type": "boolean" },
        "metadata": { "type": "boolean" },
        "dependency": { "type": "boolean" },
        "asset": { "type": "boolean" },
        "test": { "type": "boolean" },
        "generated": { "type": "boolean" },
        "data": { "type": "boolean" },
        "development": { "type": "boolean" },
        "control": { "type": "boolean" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "language",
        "root",
        "members",
        "entryFiles",
        "context",
        "data"
      ],
      "properties": {
        "handle": { "$ref": "#/$defs/nonempty" },
        "language": { "$ref": "#/$defs/identifier" },
        "root": { "$ref": "#/$defs/path" },
        "members": { "$ref": "#/$defs/paths" },
        "entryFiles": { "$ref": "#/$defs/paths" },
        "context": { "$ref": "#/$defs/paths" },
        "data": {}
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "paths", "dependsOn"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "paths": { "$ref": "#/$defs/paths" },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopes",
        "owner",
        "context",
        "path",
        "language",
        "test",
        "generated",
        "data",
        "development"
      ],
      "properties": {
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty" }
        },
        "owner": { "type": "string" },
        "context": { "$ref": "#/$defs/path" },
        "path": { "$ref": "#/$defs/path" },
        "language": { "$ref": "#/$defs/identifier" },
        "test": { "type": "boolean" },
        "generated": { "type": "boolean" },
        "data": { "type": "boolean" },
        "development": { "type": "boolean" }
      }
    },
    "policyModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "root"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "root": { "$ref": "#/$defs/path" }
      }
    },
    "policyDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "scopes", "inputs", "data"],
      "properties": {
        "kind": {
          "allOf": [{ "$ref": "#/$defs/identifier" }],
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": { "type": "integer", "minimum": 1 },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty" }
        },
        "inputs": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "data": { "type": "object" }
      }
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "go": { "type": "integer" },
        "goTest": { "type": "integer" },
        "python": { "type": "integer" },
        "typescript": { "type": "integer" },
        "typescriptTest": { "type": "integer" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewFileLines": { "type": "integer" },
        "reviewTestFileLines": { "type": "integer" },
        "maxFileLines": { "type": "integer" },
        "maxTestFileLines": { "type": "integer" },
        "complexity": { "$ref": "#/$defs/complexity" },
        "allowComments": { "type": "boolean" },
        "maxDepth": { "type": "integer" },
        "maxTestDepth": { "type": "integer" },
        "maxParams": { "type": "integer" },
        "maxTestParams": { "type": "integer" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality", "modules", "files", "declarations"],
      "properties": {
        "quality": { "$ref": "#/$defs/quality" },
        "modules": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/policyModule" }
        },
        "files": {
          "type": "array",
          "maxItems": 100000,
          "items": { "$ref": "#/$defs/source" }
        },
        "declarations": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/policyDeclaration" }
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/semanticVersion" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/semanticVersion" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
