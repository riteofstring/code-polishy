{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/riteofstring/code-polishy/main/schema/code-polishy-pack.schema.json",
  "title": "Code Polishy language pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "name",
    "version",
    "engineVersion",
    "protocolVersion",
    "platforms",
    "languages",
    "commands",
    "fixtures"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "manifestVersion": {
      "const": 3
    },
    "name": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "engineVersion": {
      "$ref": "#/$defs/semanticVersion"
    },
    "protocolVersion": {
      "const": 4
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "darwin-amd64",
          "darwin-arm64",
          "linux-amd64",
          "linux-arm64",
          "windows-amd64"
        ]
      }
    },
    "executables": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/exactPath" }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/language"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).*\\S.*$"
    },
    "concretePath": {
      "$ref": "#/$defs/path",
      "not": { "pattern": "[*?]|\\[" }
    },
    "exactPath": {
      "$ref": "#/$defs/concretePath",
      "not": { "pattern": "(?:^\\./|/\\.(?:/|$)|//|/$)" }
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "exactPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/exactPath" }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "discoveryMode"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "sourcePatterns": {
          "$ref": "#/$defs/paths"
        },
        "testPatterns": {
          "$ref": "#/$defs/paths"
        },
        "shebangs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^#!\\S(?:[^\\r\\n]*\\S)?$"
          }
        },
        "dependencyManifests": {
          "$ref": "#/$defs/paths"
        },
        "discoveryMode": {
          "enum": ["file-scoped", "static", "evaluated"]
        },
        "metadataPatterns": {
          "$ref": "#/$defs/paths"
        },
        "unsupportedCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/unsupportedCapability" }
        }
      },
      "anyOf": [
        {
          "required": ["sourcePatterns"],
          "properties": {
            "sourcePatterns": { "minItems": 1 }
          }
        },
        {
          "required": ["shebangs"],
          "properties": {
            "shebangs": { "minItems": 1 }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "discoveryMode": { "const": "file-scoped" }
            }
          },
          "then": {
            "properties": {
              "metadataPatterns": { "maxItems": 0 }
            }
          },
          "else": {
            "required": ["metadataPatterns"],
            "properties": {
              "metadataPatterns": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "unsupportedCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "reason"],
      "properties": {
        "capability": {
          "enum": [
            "format",
            "lint",
            "typecheck",
            "complexity",
            "dead-code",
            "architecture",
            "build",
            "dependency-policy",
            "lock-sync",
            "release-age",
            "security"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": ".*\\S.*"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "argv",
        "languages",
        "capabilities",
        "profiles",
        "activation",
        "timeoutSeconds",
        "execution"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/exactPath"
            }
          ],
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "format",
              "lint",
              "typecheck",
              "complexity",
              "dead-code",
              "architecture",
              "build",
              "dependency-policy",
              "lock-sync",
              "release-age",
              "security"
            ]
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "check",
              "gate",
              "format",
              "build",
              "supply-chain",
              "supply-chain-online",
              "security"
            ]
          }
        },
        "activation": {
          "enum": ["selected", "complete-or-gate"]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "environment": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "paths": {
          "$ref": "#/$defs/paths"
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "network"],
          "properties": {
            "type": { "enum": ["self-contained", "host-toolchain"] },
            "network": { "const": "none" },
            "tools": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/tool" },
              "contains": {
                "required": ["launcher"],
                "properties": { "launcher": { "const": true } }
              },
              "minContains": 0,
              "maxContains": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution": {
                "properties": { "type": { "const": "host-toolchain" } }
              }
            }
          },
          "then": {
            "properties": {
              "execution": {
                "required": ["tools"],
                "properties": { "tools": { "minItems": 1 } }
              }
            }
          },
          "else": {
            "properties": {
              "execution": {
                "properties": { "tools": { "maxItems": 0 } }
              }
            }
          }
        }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/semanticVersion" },
        "launcher": { "type": "boolean" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "command",
        "capability",
        "project",
        "files",
        "expectedStatus"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "command": {
          "$ref": "#/$defs/identifier"
        },
        "capability": {
          "$ref": "#/$defs/identifier"
        },
        "project": {
          "$ref": "#/$defs/exactPath"
        },
        "files": {
          "$ref": "#/$defs/exactPaths",
          "minItems": 1
        },
        "expectedStatus": {
          "enum": ["pass", "findings", "incomplete", "operational-failure"]
        },
        "expectedRules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expectedStatus": {
                "const": "findings"
              }
            }
          },
          "then": {
            "required": ["expectedRules"],
            "properties": {
              "expectedRules": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expectedStatus": {
                "enum": ["pass", "operational-failure"]
              }
            }
          },
          "then": {
            "properties": {
              "expectedRules": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
