{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/riteofstring/code-polishy/main/schema/code-polishy-language-conformance-report-v1.schema.json",
  "title": "Code Polishy language conformance report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocol",
    "ledger",
    "reference",
    "candidate",
    "environment",
    "fixtures",
    "summary"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/riteofstring/code-polishy/main/schema/code-polishy-language-conformance-report-v1.schema.json"
    },
    "protocol": { "const": "language-conformance-report/v1" },
    "ledger": { "$ref": "#/$defs/evidenceIdentity" },
    "reference": { "$ref": "#/$defs/executableIdentity" },
    "candidate": { "$ref": "#/$defs/executableIdentity" },
    "environment": { "$ref": "#/$defs/environmentIdentity" },
    "fixtures": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixtureEvidence" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "executableIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "policyRoot", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "policyRoot": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "version": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "environmentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "git"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "git": { "$ref": "#/$defs/toolIdentity" }
      }
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "pattern": "^[0-7]{4}$" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "branch", "indexDiffSha256", "status"],
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
        "indexDiffSha256": { "$ref": "#/$defs/digest" },
        "status": {
          "type": "array",
          "maxItems": 20000,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exitStatus",
        "report",
        "before",
        "after",
        "beforeGit",
        "afterGit"
      ],
      "properties": {
        "exitStatus": { "type": "integer" },
        "report": {
          "$ref": "https://code-polishy.dev/schema/code-polishy-report.schema.json"
        },
        "stderr": { "type": "string", "maxLength": 65536 },
        "before": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileIdentity" }
        },
        "after": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileIdentity" }
        },
        "beforeGit": { "$ref": "#/$defs/gitIdentity" },
        "afterGit": { "$ref": "#/$defs/gitIdentity" }
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reference", "candidate"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "maxLength": 1027 },
        "candidate": { "type": "string", "maxLength": 1027 }
      }
    },
    "fixtureEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "behaviorIds", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "behaviorIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "status": { "enum": ["passed", "failed", "skipped", "blocked"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "reference": { "$ref": "#/$defs/run" },
        "candidate": { "$ref": "#/$defs/run" },
        "differences": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/difference" }
        },
        "assertionFailures": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["skipped", "blocked"] } },
            "required": ["status"]
          },
          "then": {
            "required": ["reason"],
            "not": {
              "anyOf": [
                { "required": ["reference"] },
                { "required": ["candidate"] },
                { "required": ["differences"] },
                { "required": ["assertionFailures"] }
              ]
            }
          },
          "else": {
            "required": ["reference", "candidate"]
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "passed",
        "failed",
        "skipped",
        "blocked",
        "behaviors"
      ],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "behaviors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passing",
            "untested",
            "failing",
            "blocked",
            "deliberatelyChanged"
          ],
          "properties": {
            "passing": { "type": "integer", "minimum": 0 },
            "untested": { "type": "integer", "minimum": 0 },
            "failing": { "type": "integer", "minimum": 0 },
            "blocked": { "type": "integer", "minimum": 0 },
            "deliberatelyChanged": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
