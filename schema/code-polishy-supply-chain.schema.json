{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/riteofstring/code-polishy/main/schema/code-polishy-supply-chain.schema.json",
  "title": "Code Polishy supply-chain facts and evidence",
  "$defs": {
    "supplyChain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumReleaseAgeDays": { "type": "integer", "minimum": 30 },
        "preferredNewDependencyAgeDays": { "type": "integer", "minimum": 30 },
        "auditLevel": { "const": "low" },
        "recurringSecurityMonitoring": { "type": "boolean", "default": false },
        "allowedDependencyProtocols": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["workspace:", "file:", "link:"] }
        },
        "allowedLicenses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.-]+\\+?( WITH [A-Za-z0-9.-]+\\+?)?$"
          }
        },
        "npmRegistryUrl": { "type": "string", "pattern": "^https://" },
        "environment": {
          "$ref": "code-polishy.schema.json#/$defs/environment"
        },
        "releaseArtifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/releaseArtifact" }
        },
        "vulnerabilityAssessments": {
          "type": "array",
          "items": { "$ref": "#/$defs/vulnerabilityAssessment" }
        },
        "releaseAgeAssessments": {
          "type": "array",
          "items": { "$ref": "#/$defs/releaseAgeAssessment" }
        },
        "dependencyOverridePolicies": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependencyOverridePolicy" }
        },
        "artifactSecurity": { "$ref": "#/$defs/artifactSecurity" },
        "gitEvidence": { "$ref": "#/$defs/gitEvidence" }
      }
    },
    "artifactSecurity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outputDirectory": {
          "$ref": "code-polishy.schema.json#/$defs/concretePath"
        },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactTarget" }
        }
      }
    },
    "artifactTarget": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["name", "mode"],
      "properties": {
        "name": { "$ref": "code-polishy.schema.json#/$defs/identifier" },
        "module": { "$ref": "code-polishy.schema.json#/$defs/identifier" },
        "platform": { "enum": ["linux/amd64", "linux/arm64"] },
        "dockerfile": {
          "$ref": "code-polishy.schema.json#/$defs/concretePath"
        },
        "context": { "$ref": "code-polishy.schema.json#/$defs/concretePath" },
        "archive": { "$ref": "code-polishy.schema.json#/$defs/concretePath" },
        "producer": { "$ref": "#/$defs/artifactProducer" },
        "openVex": { "$ref": "code-polishy.schema.json#/$defs/concretePath" }
      },
      "oneOf": [
        {
          "properties": {
            "mode": { "const": "dockerfile" },
            "archive": false,
            "producer": false
          },
          "required": ["dockerfile", "context"]
        },
        {
          "properties": {
            "mode": { "const": "archive" },
            "dockerfile": false,
            "context": false,
            "producer": false
          },
          "required": ["archive"]
        },
        {
          "properties": {
            "mode": { "const": "command" },
            "dockerfile": false,
            "context": false,
            "archive": false
          },
          "required": ["producer"]
        }
      ]
    },
    "artifactProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": { "$ref": "code-polishy.schema.json#/$defs/argv" },
        "cwd": { "$ref": "code-polishy.schema.json#/$defs/concretePath" },
        "environment": {
          "$ref": "code-polishy.schema.json#/$defs/environment"
        },
        "manifest": { "$ref": "code-polishy.schema.json#/$defs/concretePath" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "releaseArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "versionFile", "source"],
      "properties": {
        "name": { "$ref": "code-polishy.schema.json#/$defs/identifier" },
        "versionFile": {
          "$ref": "code-polishy.schema.json#/$defs/concretePath"
        },
        "source": {
          "enum": [
            "github-release",
            "go-module",
            "go-toolchain",
            "node-runtime",
            "npm",
            "pypi",
            "python-build-standalone"
          ]
        },
        "locator": {
          "type": "string",
          "pattern": "^[A-Za-z0-9@][A-Za-z0-9._@/+~-]*$"
        },
        "tagPrefix": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9._-]*$"
        }
      }
    },
    "vulnerabilityAssessment": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["id", "ecosystem", "advisory", "package"],
      "properties": {
        "id": { "$ref": "code-polishy.schema.json#/$defs/identifier" },
        "ecosystem": { "enum": ["go", "npm", "pnpm", "pypi"] },
        "advisory": {
          "$ref": "code-polishy.schema.json#/$defs/nonemptyString"
        },
        "package": { "$ref": "code-polishy.schema.json#/$defs/nonemptyString" },
        "affectedVersion": {
          "type": "string",
          "pattern": "^[^*?\\[\\]<>=~^|,\\s]+$"
        },
        "scope": { "$ref": "code-polishy.schema.json#/$defs/concretePath" },
        "severity": { "enum": ["low", "moderate", "high"] },
        "reason": { "$ref": "code-polishy.schema.json#/$defs/nonemptyString" },
        "impact": { "$ref": "code-polishy.schema.json#/$defs/nonemptyString" },
        "evidence": { "type": "string", "pattern": "^https://" },
        "tracking": { "type": "string", "pattern": "^https://" },
        "owner": { "$ref": "code-polishy.schema.json#/$defs/nonemptyString" },
        "approvedBy": {
          "$ref": "code-polishy.schema.json#/$defs/nonemptyString"
        },
        "approval": { "type": "string", "pattern": "^https://" },
        "reviewed": { "type": "string", "format": "date" },
        "expires": { "type": "string", "format": "date" }
      },
      "allOf": [
        { "required": ["affectedVersion", "scope", "severity", "status"] },
        { "required": ["basis", "reason", "impact", "evidence"] },
        { "required": ["tracking", "owner", "approvedBy", "approval"] },
        { "required": ["reviewed", "expires"] }
      ],
      "oneOf": [
        {
          "properties": {
            "status": { "const": "not-affected" },
            "basis": { "enum": ["false-positive", "unreachable"] }
          }
        },
        {
          "properties": {
            "severity": { "enum": ["low", "moderate"] },
            "status": { "const": "risk-accepted" },
            "basis": { "enum": ["mitigated", "temporary-no-fix"] }
          }
        }
      ]
    },
    "releaseAgeAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ecosystem", "package", "version"],
      "properties": {
        "id": { "$ref": "code-polishy.schema.json#/$defs/identifier" },
        "ecosystem": { "enum": ["artifact", "go", "npm", "pnpm", "pypi"] },
        "package": { "$ref": "code-polishy.schema.json#/$defs/nonemptyString" },
        "version": { "$ref": "code-polishy.schema.json#/$defs/nonemptyString" },
        "scope": { "$ref": "code-polishy.schema.json#/$defs/concretePath" },
        "category": { "enum": ["security-fix", "supported-release"] },
        "evidence": { "type": "string", "pattern": "^https://" },
        "reason": { "$ref": "code-polishy.schema.json#/$defs/nonemptyString" },
        "owner": { "$ref": "code-polishy.schema.json#/$defs/nonemptyString" },
        "reviewed": { "type": "string", "format": "date" },
        "expires": { "type": "string", "format": "date" }
      },
      "allOf": [
        { "required": ["scope", "category", "evidence", "reason"] },
        { "required": ["owner", "reviewed", "expires"] }
      ]
    },
    "dependencyOverridePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ecosystem", "path", "field"],
      "properties": {
        "id": { "$ref": "code-polishy.schema.json#/$defs/identifier" },
        "ecosystem": { "enum": ["npm", "pnpm"] },
        "path": { "$ref": "code-polishy.schema.json#/$defs/concretePath" },
        "field": { "enum": ["overrides", "pnpm.overrides"] },
        "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reason": { "$ref": "code-polishy.schema.json#/$defs/nonemptyString" },
        "owner": { "$ref": "code-polishy.schema.json#/$defs/nonemptyString" },
        "reviewed": { "type": "string", "format": "date" },
        "expires": { "type": "string", "format": "date" }
      },
      "allOf": [
        { "required": ["contentSha256", "reason", "owner"] },
        { "required": ["reviewed", "expires"] }
      ]
    },
    "gitEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "required": { "type": "boolean", "default": false },
        "providers": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/gitEvidenceProvider" }
        },
        "attestations": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/gitEvidenceAttestation" }
        }
      }
    },
    "gitEvidenceProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "issuer",
        "publicKey",
        "policySha256",
        "scanners"
      ],
      "properties": {
        "name": {
          "$ref": "code-polishy.schema.json#/$defs/identifier",
          "maxLength": 128
        },
        "kind": { "const": "ed25519-ci/v1" },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https://"
        },
        "publicKey": { "type": "string", "minLength": 44, "maxLength": 44 },
        "policySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "scanners": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/gitEvidenceScanner" }
        }
      }
    },
    "gitEvidenceScanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "gitEvidenceAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "provider", "path"],
      "properties": {
        "scope": {
          "$ref": "code-polishy.schema.json#/$defs/concretePath",
          "maxLength": 4096
        },
        "provider": {
          "$ref": "code-polishy.schema.json#/$defs/identifier",
          "maxLength": 128
        },
        "path": {
          "$ref": "code-polishy.schema.json#/$defs/concretePath",
          "maxLength": 4096
        }
      }
    }
  }
}
