{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/riteofstring/code-polishy/main/schema/code-polishy-behavior-review.schema.json",
  "$defs": {
    "behaviorReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultRequiredAt": {
          "enum": ["on-request", "merge", "checkpoint"],
          "default": "on-request"
        },
        "features": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/behaviorReviewFeature" }
        }
      }
    },
    "behaviorReviewFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "suites"],
      "properties": {
        "name": {
          "$ref": "code-polishy.schema.json#/$defs/identifier",
          "maxLength": 128
        },
        "description": {
          "$ref": "code-polishy.schema.json#/$defs/nonemptyString",
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "aliases": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "modules": {
          "$ref": "code-polishy.schema.json#/$defs/identifierArray"
        },
        "paths": { "$ref": "code-polishy.schema.json#/$defs/paths" },
        "suites": {
          "$ref": "code-polishy.schema.json#/$defs/nonemptyIdentifierArray"
        },
        "requiredAt": { "enum": ["merge", "checkpoint"] }
      },
      "anyOf": [
        {
          "required": ["modules"],
          "properties": { "modules": { "minItems": 1 } }
        },
        { "required": ["paths"], "properties": { "paths": { "minItems": 1 } } }
      ]
    }
  }
}
