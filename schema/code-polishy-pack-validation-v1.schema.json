{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/riteofstring/code-polishy/main/schema/code-polishy-pack-validation-v1.schema.json",
  "title": "Code Polishy language pack contract validation report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "protocol", "status", "documents", "errors"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/riteofstring/code-polishy/main/schema/code-polishy-pack-validation-v1.schema.json"
    },
    "protocol": { "const": "code-polishy-pack-validation/v1" },
    "status": { "enum": ["passed", "failed"] },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/document" }
    },
    "errors": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/error" }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "kind", "path", "sha256"],
      "properties": {
        "role": { "enum": ["input", "request"] },
        "kind": { "enum": ["manifest", "request", "response"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "phase", "path", "message"],
      "properties": {
        "document": { "enum": ["input", "request"] },
        "phase": { "enum": ["schema", "decode", "semantic"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "expected": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    }
  }
}
