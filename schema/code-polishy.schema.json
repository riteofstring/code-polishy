{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/riteofstring/code-polishy/main/schema/code-polishy.schema.json",
  "title": "Code Polishy project facts and overrides",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "modules", "tests"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "version": { "const": 4 },
    "project": { "$ref": "#/$defs/project" },
    "scope": { "$ref": "#/$defs/scope" },
    "quality": { "$ref": "#/$defs/quality" },
    "portability": { "$ref": "#/$defs/portability" },
    "documentation": { "$ref": "#/$defs/documentation" },
    "generation": { "$ref": "#/$defs/generation" },
    "verification": { "$ref": "#/$defs/verification" },
    "packs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/packSelection" }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "tests": { "$ref": "#/$defs/tests" },
    "supplyChain": {
      "$ref": "code-polishy-supply-chain.schema.json#/$defs/supplyChain"
    },
    "policyModules": { "$ref": "#/$defs/policyModules" },
    "exceptions": { "type": "array", "items": { "$ref": "#/$defs/exception" } }
  },
  "$defs": {
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "producers": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/generationProducer" }
        }
      }
    },
    "generationProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "outputs", "inputs", "generate", "verify"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier", "maxLength": 128 },
        "outputs": { "$ref": "#/$defs/generationPatterns" },
        "inputs": { "$ref": "#/$defs/generationPatterns" },
        "generate": { "$ref": "#/$defs/generationCommand" },
        "verify": { "$ref": "#/$defs/generationCommand" }
      }
    },
    "generationPatterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path", "maxLength": 4096 }
    },
    "generationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/nonemptyString", "maxLength": 4096 }
        },
        "cwd": { "$ref": "#/$defs/concretePath", "maxLength": 4096 },
        "environment": {
          "$ref": "#/$defs/environment",
          "maxItems": 64,
          "items": { "maxLength": 4096 }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "nonemptyString": { "type": "string", "pattern": ".*\\S.*" },
    "identifierArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "nonemptyIdentifierArray": {
      "allOf": [{ "$ref": "#/$defs/identifierArray" }, { "minItems": 1 }]
    },
    "environment": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).*\\S.*$"
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "nonemptyPaths": {
      "allOf": [{ "$ref": "#/$defs/paths" }, { "minItems": 1 }]
    },
    "concretePath": {
      "$ref": "#/$defs/path",
      "not": { "pattern": "[*?]|\\[" }
    },
    "exactPath": {
      "$ref": "#/$defs/concretePath",
      "not": { "pattern": "(?:^\\./|/\\.(?:/|$)|//|/$)" }
    },
    "literalExactPath": {
      "$ref": "#/$defs/exactPath",
      "not": { "pattern": "[{}]" }
    },
    "pyprojectPath": {
      "$ref": "#/$defs/literalExactPath",
      "pattern": "(?:^|/)pyproject\\.toml$"
    },
    "exactPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/exactPath" }
    },
    "markdownPath": {
      "$ref": "#/$defs/exactPath",
      "pattern": "\\.(?:[mM][dD]|[mM][aA][rR][kK][dD][oO][wW][nN])$"
    },
    "markdownPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/markdownPath" }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/identifier" },
        "capabilities": { "$ref": "#/$defs/identifierArray" }
      }
    },
    "packSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exclude": { "$ref": "#/$defs/paths" },
        "generated": { "$ref": "#/$defs/paths" },
        "data": { "$ref": "#/$defs/paths" },
        "entryPoints": { "$ref": "#/$defs/paths" },
        "generatedJavaScript": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/generatedJavaScript" }
        },
        "pythonContracts": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "code-polishy-python.schema.json#/$defs/contract" }
        },
        "pythonDynamicReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pythonDynamicReference" }
        },
        "pythonComputedImports": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pythonComputedImport" }
        },
        "pythonExternalPluginImports": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "code-polishy-python.schema.json#/$defs/externalPluginImport"
          }
        },
        "pythonExternalAttributes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pythonExternalAttribute" }
        },
        "development": { "$ref": "#/$defs/paths" },
        "languages": {
          "type": "array",
          "items": { "$ref": "#/$defs/languageRule" }
        }
      }
    },
    "languageRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "paths"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "paths": { "$ref": "#/$defs/nonemptyPaths" }
      }
    },
    "generatedJavaScript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "sourcePackage"],
      "properties": {
        "paths": { "$ref": "#/$defs/nonemptyPaths" },
        "sourcePackage": {
          "$ref": "#/$defs/exactPath",
          "pattern": "(?:^|/)package\\.json$"
        }
      }
    },
    "pythonDynamicReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "project", "consumer"],
      "properties": {
        "kind": { "enum": ["target", "registry"] },
        "project": { "$ref": "#/$defs/pyprojectPath" },
        "target": { "$ref": "#/$defs/pythonDynamicTarget" },
        "registry": { "$ref": "#/$defs/pythonDynamicRegistry" },
        "consumer": {
          "oneOf": [
            { "$ref": "#/$defs/pythonDynamicConsumer" },
            { "$ref": "#/$defs/pythonExternalReachabilityConsumer" }
          ]
        }
      },
      "oneOf": [
        {
          "properties": { "kind": { "const": "target" } },
          "required": ["target"],
          "not": { "required": ["registry"] }
        },
        {
          "properties": {
            "kind": { "const": "registry" },
            "consumer": { "$ref": "#/$defs/pythonDynamicConsumer" }
          },
          "required": ["registry"],
          "not": { "required": ["target"] }
        }
      ]
    },
    "pythonComputedImport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "importer", "module", "callee"],
      "properties": {
        "project": { "$ref": "#/$defs/pyprojectPath" },
        "importer": {
          "$ref": "#/$defs/literalExactPath",
          "pattern": "[.]pyi?$"
        },
        "module": { "$ref": "#/$defs/pythonIdentifierChain" },
        "callable": { "$ref": "#/$defs/pythonIdentifierChain" },
        "moduleScope": { "const": true },
        "callee": {
          "enum": [
            "importlib.import_module",
            "builtins.__import__",
            "pkgutil.resolve_name"
          ]
        },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "shape": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "argument": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "namespace": { "$ref": "#/$defs/pythonIdentifierChain" },
        "entryPointGroup": { "$ref": "#/$defs/identifier" },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pythonIdentifierChain" }
        },
        "configuration": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pythonObjectImportInput" }
        }
      },
      "allOf": [
        { "required": ["line", "column", "shape", "argument"] },
        { "required": ["sourceSha256"] },
        {
          "if": {
            "properties": { "callee": { "const": "pkgutil.resolve_name" } }
          },
          "then": {
            "required": ["namespace", "configuration"],
            "properties": {
              "shape": { "const": "module-object-call/v1" },
              "targets": { "maxItems": 0 },
              "entryPointGroup": false,
              "configuration": { "minItems": 1, "maxItems": 1 }
            }
          },
          "else": {
            "properties": {
              "configuration": {
                "items": { "$ref": "#/$defs/pythonComputedImportInput" }
              }
            }
          }
        },
        {
          "oneOf": [
            {
              "required": ["callable"],
              "properties": { "moduleScope": false }
            },
            { "required": ["moduleScope"], "properties": { "callable": false } }
          ]
        },
        {
          "oneOf": [
            {
              "required": ["namespace"],
              "properties": { "entryPointGroup": false }
            },
            {
              "required": ["entryPointGroup"],
              "properties": { "namespace": false }
            }
          ]
        },
        {
          "if": { "required": ["entryPointGroup"] },
          "then": {
            "properties": {
              "targets": { "maxItems": 0 },
              "configuration": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "pythonComputedImportInput": {
      "allOf": [
        { "$ref": "#/$defs/pythonObjectImportInput" },
        { "properties": { "jsonPointer": { "minLength": 1 } } }
      ]
    },
    "pythonObjectImportInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "jsonPointer", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/literalExactPath", "pattern": "[.]json$" },
        "jsonPointer": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^(?:/[^*\\r\\n\\u0000]*)?$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pythonExternalAttribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "module",
        "callable",
        "receiver",
        "attribute",
        "write"
      ],
      "properties": {
        "project": { "$ref": "#/$defs/pyprojectPath" },
        "module": { "$ref": "#/$defs/pythonIdentifierChain" },
        "callable": { "$ref": "#/$defs/pythonIdentifierChain" },
        "receiver": { "$ref": "#/$defs/pythonExternalReceiver" },
        "attribute": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "write": { "$ref": "#/$defs/pythonSourceLocation" }
      }
    },
    "pythonIdentifierChain": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "go": { "type": "integer", "minimum": 1, "maximum": 12 },
        "goTest": { "type": "integer", "minimum": 1, "maximum": 20 },
        "python": { "type": "integer", "minimum": 1, "maximum": 10 },
        "typescript": { "type": "integer", "minimum": 1, "maximum": 10 },
        "typescriptTest": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFileLines": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxTestFileLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1500
        },
        "complexity": { "$ref": "#/$defs/complexity" },
        "allowComments": { "type": "boolean", "default": true },
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 4 },
        "maxTestDepth": { "type": "integer", "minimum": 1, "maximum": 8 },
        "maxParams": { "type": "integer", "minimum": 1, "maximum": 5 },
        "maxTestParams": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "portability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "externalInputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/externalInput" }
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "design": {
          "type": "array",
          "items": { "$ref": "#/$defs/designDocument" }
        },
        "handoffs": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/operationalHandoff" }
        },
        "productInputs": { "$ref": "#/$defs/markdownPaths" }
      }
    },
    "handoffIdentifiers": {
      "$ref": "#/$defs/nonemptyIdentifierArray",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/identifier", "maxLength": 128 }
    },
    "operationalHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "path"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier", "maxLength": 128 },
        "description": {
          "$ref": "#/$defs/nonemptyString",
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "path": {
          "$ref": "#/$defs/markdownPath",
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f:]+$"
        },
        "situations": { "$ref": "#/$defs/handoffIdentifiers" },
        "modules": { "$ref": "#/$defs/handoffIdentifiers" },
        "sourcePaths": {
          "$ref": "#/$defs/exactPaths",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/literalExactPath",
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f:]+$"
          }
        }
      },
      "anyOf": [
        { "required": ["situations"] },
        { "required": ["modules"] },
        { "required": ["sourcePaths"] }
      ]
    },
    "designDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "$ref": "#/$defs/exactPath",
          "pattern": "^docs/design/.+\\.md$"
        },
        "module": { "$ref": "#/$defs/identifier" },
        "sourcePaths": {
          "allOf": [{ "$ref": "#/$defs/exactPaths" }, { "minItems": 1 }]
        }
      },
      "oneOf": [
        { "required": ["module"], "properties": { "sourcePaths": false } },
        { "required": ["sourcePaths"], "properties": { "module": false } }
      ]
    },
    "externalInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "module", "sourcePaths"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["directory", "file", "repository", "service"] },
        "module": { "$ref": "#/$defs/identifier" },
        "sourcePaths": { "$ref": "#/$defs/nonemptyPaths" },
        "resolution": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["cli", "config", "environment", "default"] }
        },
        "environment": { "$ref": "#/$defs/environment" },
        "unavailableBehavior": { "enum": ["fail", "warn"] },
        "contractSuite": { "$ref": "#/$defs/identifier" },
        "behaviorSuite": { "$ref": "#/$defs/identifier" },
        "siblingFallback": {
          "type": "string",
          "pattern": "^(?:\\.\\./)+[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        }
      },
      "allOf": [
        { "required": ["resolution", "unavailableBehavior"] },
        { "required": ["contractSuite", "behaviorSuite"] }
      ]
    },
    "verification": {
      "type": "object",
      "description": "Behavior-review and merge-gate selection facts, with optional checked-in merge-target guidance.",
      "additionalProperties": false,
      "properties": {
        "finalGateOwner": {
          "enum": ["local", "ci"],
          "default": "local",
          "description": "One owner for final merge-gate execution; CI ownership requires a literal checked-in workflow command."
        },
        "trustedMergeTarget": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000]+$",
          "description": "Optional checked-in trusted merge target used when the caller supplies no explicit target."
        },
        "behaviorReview": {
          "$ref": "code-polishy-behavior-review.schema.json#/$defs/behaviorReview"
        },
        "mergeGate": { "$ref": "#/$defs/mergeGate" }
      }
    },
    "mergeGate": {
      "type": "object",
      "description": "Allows merge-gate to select the recommended ordinary profile only for these modules; all other changes select the complete full gate.",
      "additionalProperties": false,
      "required": ["recommendedModules"],
      "properties": {
        "recommendedModules": { "$ref": "#/$defs/nonemptyIdentifierArray" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "paths"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "paths": { "$ref": "#/$defs/nonemptyPaths" },
        "dependsOn": { "$ref": "#/$defs/identifierArray" },
        "capabilities": { "$ref": "#/$defs/identifierArray" }
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonemptyString" }
    },
    "commandBase": {
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "argv": { "$ref": "#/$defs/argv" },
        "cwd": { "$ref": "#/$defs/concretePath" },
        "paths": { "$ref": "#/$defs/paths" },
        "modules": { "$ref": "#/$defs/identifierArray" },
        "environment": { "$ref": "#/$defs/environment" },
        "exclusiveResources": { "$ref": "#/$defs/identifierArray" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "check": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["name", "provides", "argv"],
      "properties": {
        "provides": { "$ref": "#/$defs/nonemptyIdentifierArray" },
        "runOn": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "check",
              "gate",
              "format",
              "build",
              "security",
              "supply-chain",
              "supply-chain-online"
            ]
          }
        }
      },
      "allOf": [{ "$ref": "#/$defs/commandBase" }]
    },
    "testSuite": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["name", "kind", "scope", "argv"],
      "properties": {
        "kind": { "$ref": "#/$defs/identifier" },
        "scope": { "enum": ["module", "repository"] },
        "reusable": { "type": "boolean" },
        "cost": { "enum": ["quick", "standard", "expensive"] },
        "extraInputs": { "$ref": "#/$defs/paths" },
        "covers": { "$ref": "#/$defs/identifierArray" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/testArtifact" }
        },
        "runOn": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["focused", "recommended", "full", "supplemental"]
          }
        }
      },
      "allOf": [
        { "$ref": "#/$defs/commandBase" },
        {
          "if": { "properties": { "scope": { "const": "module" } } },
          "then": {
            "required": ["modules"],
            "properties": { "modules": { "minItems": 1, "maxItems": 1 } }
          },
          "else": { "properties": { "modules": { "maxItems": 0 } } }
        },
        {
          "if": {
            "required": ["runOn"],
            "properties": { "runOn": { "contains": { "const": "focused" } } }
          },
          "then": {
            "properties": {
              "cost": { "const": "quick" },
              "runOn": {
                "allOf": [
                  { "contains": { "const": "recommended" } },
                  { "contains": { "const": "full" } }
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["runOn"],
            "properties": {
              "runOn": { "contains": { "const": "recommended" } }
            }
          },
          "then": {
            "properties": {
              "cost": { "enum": ["quick", "standard"] },
              "runOn": { "contains": { "const": "full" } }
            }
          }
        },
        {
          "if": {
            "required": ["runOn"],
            "properties": {
              "runOn": { "contains": { "const": "supplemental" } }
            }
          },
          "then": {
            "properties": {
              "cost": { "const": "expensive" },
              "runOn": { "maxItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "acceptance-mutation",
                  "crap",
                  "gherkin-mutation",
                  "mutation",
                  "risk-analysis"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "cost": { "const": "expensive" },
              "runOn": { "contains": { "const": "supplemental" } }
            }
          }
        }
      ]
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownership", "suites"],
      "properties": {
        "paths": { "$ref": "#/$defs/paths", "maxItems": 1024 },
        "ownership": {
          "type": "array",
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/testOwnership" }
        },
        "requiredKinds": { "$ref": "#/$defs/identifierArray" },
        "requiredSupplementalKinds": { "$ref": "#/$defs/identifierArray" },
        "suites": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/testSuite" }
        }
      }
    },
    "testOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "module", "focusedSuite"],
      "properties": {
        "paths": { "$ref": "#/$defs/nonemptyPaths", "maxItems": 128 },
        "module": { "$ref": "#/$defs/identifier" },
        "focusedSuite": { "$ref": "#/$defs/identifier" }
      }
    },
    "testArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type"],
      "properties": {
        "path": { "$ref": "#/$defs/exactPath", "pattern": "\\.[xX][mM][lL]$" },
        "type": { "enum": ["junit", "cobertura"] },
        "required": { "type": "boolean", "default": false }
      }
    },
    "policyModules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overrides": {
          "type": "array",
          "items": { "$ref": "#/$defs/policyModuleOverride" }
        }
      }
    },
    "policyModuleOverride": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["name", "mode"],
      "properties": {
        "name": {
          "enum": ["electron", "osv", "react", "ruff", "ty", "vulture"]
        },
        "root": { "$ref": "#/$defs/concretePath" },
        "reason": { "$ref": "#/$defs/nonemptyString" },
        "owner": { "$ref": "#/$defs/nonemptyString" },
        "expires": { "type": "string", "format": "date" }
      },
      "oneOf": [
        {
          "properties": { "mode": { "const": "disabled" } },
          "required": ["reason", "owner", "expires"]
        },
        {
          "properties": {
            "mode": { "const": "enabled" },
            "reason": false,
            "owner": false,
            "expires": false
          }
        }
      ]
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check", "path", "subject"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "check": { "type": "string", "pattern": "^[^*?\\[\\]]+$" },
        "path": { "$ref": "#/$defs/concretePath" },
        "subject": { "type": "string", "pattern": "^[^*?\\[\\]]+$" },
        "reason": { "$ref": "#/$defs/nonemptyString" },
        "owner": { "$ref": "#/$defs/nonemptyString" },
        "expires": { "type": "string", "format": "date" }
      },
      "allOf": [{ "required": ["reason", "owner", "expires"] }]
    },
    "pythonSourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "pythonExternalReceiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "binding"],
      "properties": {
        "kind": { "enum": ["parameter", "local", "self"] },
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "binding": { "$ref": "#/$defs/pythonSourceLocation" },
        "type": { "$ref": "#/$defs/pythonIdentifierChain", "pattern": "\\." },
        "consumer": { "$ref": "#/$defs/pythonExternalConsumer" }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "enum": ["parameter", "local"] },
            "consumer": false
          },
          "required": ["type"]
        },
        {
          "properties": { "kind": { "const": "self" }, "type": false },
          "required": ["consumer"]
        }
      ]
    },
    "pythonExternalConsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "qualified", "site"],
      "properties": {
        "kind": { "enum": ["base", "protocol", "decorator", "registration"] },
        "qualified": {
          "$ref": "#/$defs/pythonIdentifierChain",
          "pattern": "\\."
        },
        "site": { "$ref": "#/$defs/pythonSourceLocation" }
      }
    },
    "pythonDynamicTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "symbol"],
      "properties": {
        "module": { "$ref": "#/$defs/pythonIdentifierChain" },
        "symbol": { "$ref": "#/$defs/pythonIdentifierChain" }
      }
    },
    "pythonDynamicRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "jsonPointer"],
      "properties": {
        "path": { "$ref": "#/$defs/literalExactPath" },
        "jsonPointer": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^(?:/(?:[^~]|~[01])*)*$"
        }
      }
    },
    "pythonExternalReachabilityConsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "importer",
        "module",
        "site",
        "sourceSha256",
        "distribution",
        "qualified",
        "implementation",
        "member"
      ],
      "properties": {
        "kind": { "enum": ["base", "protocol", "decorator", "entry-point"] },
        "importer": { "$ref": "#/$defs/literalExactPath", "pattern": "\\.py$" },
        "module": { "$ref": "#/$defs/pythonIdentifierChain" },
        "site": { "$ref": "#/$defs/pythonSourceLocation" },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "distribution": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "qualified": { "$ref": "#/$defs/pythonIdentifierChain" },
        "implementation": { "$ref": "#/$defs/pythonIdentifierChain" },
        "member": { "$ref": "#/$defs/pythonIdentifierChain" }
      }
    },
    "pythonDynamicConsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "importer",
        "module",
        "callable",
        "site",
        "callee",
        "shape",
        "argument",
        "sourceSha256"
      ],
      "properties": {
        "kind": { "const": "callsite" },
        "importer": { "$ref": "#/$defs/literalExactPath", "pattern": "\\.py$" },
        "module": { "$ref": "#/$defs/pythonIdentifierChain" },
        "callable": { "$ref": "#/$defs/pythonIdentifierChain" },
        "site": { "$ref": "#/$defs/pythonSourceLocation" },
        "callee": { "const": "pkgutil.resolve_name" },
        "shape": { "const": "module-object-call/v1" },
        "argument": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
