{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/riteofstring/code-polishy/main/schema/code-polishy.schema.json",
  "title": "Code Polishy project facts and overrides",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "modules", "tests"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "version": { "const": 3 },
    "project": { "$ref": "#/$defs/project" },
    "scope": { "$ref": "#/$defs/scope" },
    "quality": { "$ref": "#/$defs/quality" },
    "portability": { "$ref": "#/$defs/portability" },
    "documentation": { "$ref": "#/$defs/documentation" },
    "verification": { "$ref": "#/$defs/verification" },
    "packs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/packSelection" }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "tests": { "$ref": "#/$defs/tests" },
    "supplyChain": { "$ref": "#/$defs/supplyChain" },
    "policyModules": { "$ref": "#/$defs/policyModules" },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "nonemptyString": { "type": "string", "pattern": ".*\\S.*" },
    "identifierArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "nonemptyIdentifierArray": {
      "allOf": [{ "$ref": "#/$defs/identifierArray" }, { "minItems": 1 }]
    },
    "environment": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).*\\S.*$"
    },
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "nonemptyPaths": {
      "allOf": [{ "$ref": "#/$defs/paths" }, { "minItems": 1 }]
    },
    "concretePath": {
      "$ref": "#/$defs/path",
      "not": { "pattern": "[*?]|\\[" }
    },
    "exactPath": {
      "$ref": "#/$defs/concretePath",
      "not": { "pattern": "(?:^\\./|/\\.(?:/|$)|//|/$)" }
    },
    "literalExactPath": {
      "$ref": "#/$defs/exactPath",
      "not": { "pattern": "[{}]" }
    },
    "pyprojectPath": {
      "$ref": "#/$defs/literalExactPath",
      "pattern": "(?:^|/)pyproject\\.toml$"
    },
    "exactPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/exactPath" }
    },
    "markdownPath": {
      "$ref": "#/$defs/exactPath",
      "pattern": "\\.(?:[mM][dD]|[mM][aA][rR][kK][dD][oO][wW][nN])$"
    },
    "markdownPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/markdownPath" }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/identifier" },
        "capabilities": { "$ref": "#/$defs/identifierArray" }
      }
    },
    "packSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exclude": { "$ref": "#/$defs/paths" },
        "generated": { "$ref": "#/$defs/paths" },
        "data": { "$ref": "#/$defs/paths" },
        "tests": { "$ref": "#/$defs/paths" },
        "entryPoints": { "$ref": "#/$defs/paths" },
        "generatedJavaScript": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/generatedJavaScript" }
        },
        "pythonDynamicReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pythonDynamicReference" }
        },
        "pythonComputedImports": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pythonComputedImport" }
        },
        "pythonExternalAttributes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pythonExternalAttribute" }
        },
        "development": { "$ref": "#/$defs/paths" },
        "languages": {
          "type": "array",
          "items": { "$ref": "#/$defs/languageRule" }
        }
      }
    },
    "languageRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "paths"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "paths": { "$ref": "#/$defs/nonemptyPaths" }
      }
    },
    "generatedJavaScript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "sourcePackage"],
      "properties": {
        "paths": { "$ref": "#/$defs/nonemptyPaths" },
        "sourcePackage": {
          "$ref": "#/$defs/exactPath",
          "pattern": "(?:^|/)package\\.json$"
        }
      }
    },
    "pythonDynamicReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "module", "symbol"],
      "properties": {
        "project": { "$ref": "#/$defs/pyprojectPath" },
        "module": { "$ref": "#/$defs/pythonIdentifierChain" },
        "symbol": { "$ref": "#/$defs/pythonIdentifierChain" }
      }
    },
    "pythonComputedImport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "importer", "module", "callee"],
      "properties": {
        "project": { "$ref": "#/$defs/pyprojectPath" },
        "importer": {
          "$ref": "#/$defs/literalExactPath",
          "pattern": "[.]pyi?$"
        },
        "module": { "$ref": "#/$defs/pythonIdentifierChain" },
        "callable": { "$ref": "#/$defs/pythonIdentifierChain" },
        "moduleScope": { "const": true },
        "callee": {
          "enum": ["importlib.import_module", "builtins.__import__"]
        },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "shape": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "argument": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "namespace": { "$ref": "#/$defs/pythonIdentifierChain" },
        "entryPointGroup": { "$ref": "#/$defs/identifier" },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pythonIdentifierChain" }
        },
        "configuration": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pythonComputedImportInput" }
        }
      },
      "allOf": [
        { "required": ["line", "column", "shape", "argument"] },
        { "required": ["sourceSha256"] },
        {
          "oneOf": [
            {
              "required": ["callable"],
              "properties": { "moduleScope": false }
            },
            { "required": ["moduleScope"], "properties": { "callable": false } }
          ]
        },
        {
          "oneOf": [
            {
              "required": ["namespace"],
              "properties": { "entryPointGroup": false }
            },
            {
              "required": ["entryPointGroup"],
              "properties": { "namespace": false }
            }
          ]
        },
        {
          "if": {
            "required": ["entryPointGroup"]
          },
          "then": {
            "properties": {
              "targets": { "maxItems": 0 },
              "configuration": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "pythonComputedImportInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "jsonPointer", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/literalExactPath",
          "pattern": "[.]json$"
        },
        "jsonPointer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^*\\r\\n\\u0000]*$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pythonExternalAttribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "module", "callable", "receiver"],
      "properties": {
        "project": { "$ref": "#/$defs/pyprojectPath" },
        "module": { "$ref": "#/$defs/pythonIdentifierChain" },
        "callable": { "$ref": "#/$defs/pythonIdentifierChain" },
        "receiver": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "attribute": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "line": { "type": "integer", "minimum": 1 },
        "consumerType": {
          "$ref": "#/$defs/pythonIdentifierChain",
          "pattern": "\\."
        }
      },
      "allOf": [{ "required": ["attribute", "line", "consumerType"] }]
    },
    "pythonIdentifierChain": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "go": { "type": "integer", "minimum": 1, "maximum": 12 },
        "goTest": { "type": "integer", "minimum": 1, "maximum": 20 },
        "python": { "type": "integer", "minimum": 1, "maximum": 10 },
        "typescript": { "type": "integer", "minimum": 1, "maximum": 10 },
        "typescriptTest": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFileLines": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxTestFileLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1500
        },
        "complexity": { "$ref": "#/$defs/complexity" },
        "allowComments": { "type": "boolean", "default": true },
        "maxDepth": { "type": "integer", "minimum": 1, "maximum": 4 },
        "maxTestDepth": { "type": "integer", "minimum": 1, "maximum": 8 },
        "maxParams": { "type": "integer", "minimum": 1, "maximum": 5 },
        "maxTestParams": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "portability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "externalInputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/externalInput" }
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "design": {
          "type": "array",
          "items": { "$ref": "#/$defs/designDocument" }
        },
        "productInputs": { "$ref": "#/$defs/markdownPaths" }
      }
    },
    "designDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "$ref": "#/$defs/exactPath",
          "pattern": "^docs/design/.+\\.md$"
        },
        "module": { "$ref": "#/$defs/identifier" },
        "sourcePaths": {
          "allOf": [{ "$ref": "#/$defs/exactPaths" }, { "minItems": 1 }]
        }
      },
      "oneOf": [
        { "required": ["module"], "properties": { "sourcePaths": false } },
        { "required": ["sourcePaths"], "properties": { "module": false } }
      ]
    },
    "externalInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "module", "sourcePaths"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": ["directory", "file", "repository", "service"]
        },
        "module": { "$ref": "#/$defs/identifier" },
        "sourcePaths": { "$ref": "#/$defs/nonemptyPaths" },
        "resolution": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["cli", "config", "environment", "default"]
          }
        },
        "environment": { "$ref": "#/$defs/environment" },
        "unavailableBehavior": {
          "enum": ["fail", "warn"]
        },
        "contractSuite": { "$ref": "#/$defs/identifier" },
        "behaviorSuite": { "$ref": "#/$defs/identifier" },
        "siblingFallback": {
          "type": "string",
          "pattern": "^(?:\\.\\./)+[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        }
      },
      "allOf": [
        { "required": ["resolution", "unavailableBehavior"] },
        { "required": ["contractSuite", "behaviorSuite"] }
      ]
    },
    "verification": {
      "type": "object",
      "description": "Behavior-review and merge-gate selection facts, with optional checked-in merge-target guidance.",
      "additionalProperties": false,
      "properties": {
        "finalGateOwner": {
          "enum": ["local", "ci"],
          "default": "local",
          "description": "One owner for final merge-gate execution; CI ownership requires a literal checked-in workflow command."
        },
        "trustedMergeTarget": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000]+$",
          "description": "Optional checked-in trusted merge target used when the caller supplies no explicit target."
        },
        "behaviorReview": { "$ref": "#/$defs/behaviorReview" },
        "mergeGate": { "$ref": "#/$defs/mergeGate" }
      }
    },
    "behaviorReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultRequiredAt": {
          "enum": ["on-request", "merge", "checkpoint"],
          "default": "on-request"
        },
        "features": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/behaviorReviewFeature" }
        }
      }
    },
    "behaviorReviewFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "suites"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier", "maxLength": 128 },
        "description": {
          "$ref": "#/$defs/nonemptyString",
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "aliases": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "modules": { "$ref": "#/$defs/identifierArray" },
        "paths": { "$ref": "#/$defs/paths" },
        "suites": { "$ref": "#/$defs/nonemptyIdentifierArray" },
        "requiredAt": {
          "enum": ["merge", "checkpoint"]
        }
      },
      "anyOf": [
        {
          "required": ["modules"],
          "properties": { "modules": { "minItems": 1 } }
        },
        { "required": ["paths"], "properties": { "paths": { "minItems": 1 } } }
      ]
    },
    "mergeGate": {
      "type": "object",
      "description": "Allows merge-gate to select the recommended ordinary profile only for these modules; all other changes select the complete full gate.",
      "additionalProperties": false,
      "required": ["recommendedModules"],
      "properties": {
        "recommendedModules": { "$ref": "#/$defs/nonemptyIdentifierArray" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "paths"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "paths": { "$ref": "#/$defs/nonemptyPaths" },
        "dependsOn": { "$ref": "#/$defs/identifierArray" },
        "capabilities": { "$ref": "#/$defs/identifierArray" }
      }
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonemptyString" }
    },
    "commandBase": {
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "argv": { "$ref": "#/$defs/argv" },
        "cwd": { "$ref": "#/$defs/concretePath" },
        "paths": { "$ref": "#/$defs/paths" },
        "modules": { "$ref": "#/$defs/identifierArray" },
        "environment": { "$ref": "#/$defs/environment" },
        "exclusiveResources": { "$ref": "#/$defs/identifierArray" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "check": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["name", "provides", "argv"],
      "properties": {
        "provides": { "$ref": "#/$defs/nonemptyIdentifierArray" },
        "runOn": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "check",
              "gate",
              "format",
              "build",
              "security",
              "supply-chain",
              "supply-chain-online"
            ]
          }
        }
      },
      "allOf": [{ "$ref": "#/$defs/commandBase" }]
    },
    "testSuite": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["name", "kind", "scope", "argv"],
      "properties": {
        "kind": { "$ref": "#/$defs/identifier" },
        "scope": {
          "enum": ["module", "repository"]
        },
        "reusable": { "type": "boolean" },
        "cost": {
          "enum": ["quick", "standard", "expensive"]
        },
        "extraInputs": { "$ref": "#/$defs/paths" },
        "covers": { "$ref": "#/$defs/identifierArray" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/testArtifact" }
        },
        "runOn": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["focused", "recommended", "full", "supplemental"]
          }
        }
      },
      "allOf": [
        { "$ref": "#/$defs/commandBase" },
        {
          "if": {
            "properties": {
              "scope": { "const": "module" }
            }
          },
          "then": {
            "required": ["modules"],
            "properties": {
              "modules": { "minItems": 1, "maxItems": 1 }
            }
          },
          "else": {
            "properties": {
              "modules": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "required": ["runOn"],
            "properties": {
              "runOn": {
                "contains": { "const": "focused" }
              }
            }
          },
          "then": {
            "properties": {
              "cost": { "const": "quick" },
              "runOn": {
                "allOf": [
                  { "contains": { "const": "recommended" } },
                  { "contains": { "const": "full" } }
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": ["runOn"],
            "properties": {
              "runOn": {
                "contains": { "const": "recommended" }
              }
            }
          },
          "then": {
            "properties": {
              "cost": {
                "enum": ["quick", "standard"]
              },
              "runOn": {
                "contains": { "const": "full" }
              }
            }
          }
        },
        {
          "if": {
            "required": ["runOn"],
            "properties": {
              "runOn": {
                "contains": { "const": "supplemental" }
              }
            }
          },
          "then": {
            "properties": {
              "cost": { "const": "expensive" },
              "runOn": { "maxItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "acceptance-mutation",
                  "crap",
                  "gherkin-mutation",
                  "mutation",
                  "risk-analysis"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "cost": { "const": "expensive" },
              "runOn": {
                "contains": { "const": "supplemental" }
              }
            }
          }
        }
      ]
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suites"],
      "properties": {
        "requiredKinds": { "$ref": "#/$defs/identifierArray" },
        "requiredSupplementalKinds": { "$ref": "#/$defs/identifierArray" },
        "suites": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/testSuite" }
        }
      }
    },
    "testArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type"],
      "properties": {
        "path": {
          "$ref": "#/$defs/exactPath",
          "pattern": "\\.[xX][mM][lL]$"
        },
        "type": {
          "enum": ["junit", "cobertura"]
        },
        "required": { "type": "boolean", "default": false }
      }
    },
    "supplyChain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumReleaseAgeDays": { "type": "integer", "minimum": 30 },
        "preferredNewDependencyAgeDays": { "type": "integer", "minimum": 30 },
        "auditLevel": { "const": "low" },
        "recurringSecurityMonitoring": { "type": "boolean", "default": false },
        "allowedDependencyProtocols": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["workspace:", "file:", "link:"]
          }
        },
        "allowedLicenses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.-]+\\+?( WITH [A-Za-z0-9.-]+\\+?)?$"
          }
        },
        "npmRegistryUrl": { "type": "string", "pattern": "^https://" },
        "environment": { "$ref": "#/$defs/environment" },
        "releaseArtifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/releaseArtifact" }
        },
        "vulnerabilityAssessments": {
          "type": "array",
          "items": { "$ref": "#/$defs/vulnerabilityAssessment" }
        },
        "releaseAgeAssessments": {
          "type": "array",
          "items": { "$ref": "#/$defs/releaseAgeAssessment" }
        },
        "dependencyOverridePolicies": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependencyOverridePolicy" }
        },
        "artifactSecurity": { "$ref": "#/$defs/artifactSecurity" }
      }
    },
    "artifactSecurity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outputDirectory": { "$ref": "#/$defs/concretePath" },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactTarget" }
        }
      }
    },
    "artifactTarget": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["name", "mode"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "module": { "$ref": "#/$defs/identifier" },
        "platform": {
          "enum": ["linux/amd64", "linux/arm64"]
        },
        "dockerfile": { "$ref": "#/$defs/concretePath" },
        "context": { "$ref": "#/$defs/concretePath" },
        "archive": { "$ref": "#/$defs/concretePath" },
        "producer": { "$ref": "#/$defs/artifactProducer" },
        "openVex": { "$ref": "#/$defs/concretePath" }
      },
      "oneOf": [
        {
          "properties": {
            "mode": { "const": "dockerfile" },
            "archive": false,
            "producer": false
          },
          "required": ["dockerfile", "context"]
        },
        {
          "properties": {
            "mode": { "const": "archive" },
            "dockerfile": false,
            "context": false,
            "producer": false
          },
          "required": ["archive"]
        },
        {
          "properties": {
            "mode": { "const": "command" },
            "dockerfile": false,
            "context": false,
            "archive": false
          },
          "required": ["producer"]
        }
      ]
    },
    "artifactProducer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": { "$ref": "#/$defs/argv" },
        "cwd": { "$ref": "#/$defs/concretePath" },
        "environment": { "$ref": "#/$defs/environment" },
        "manifest": { "$ref": "#/$defs/concretePath" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "releaseArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "versionFile", "source"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "versionFile": { "$ref": "#/$defs/concretePath" },
        "source": {
          "enum": [
            "github-release",
            "go-module",
            "go-toolchain",
            "node-runtime",
            "npm",
            "pypi",
            "python-build-standalone"
          ]
        },
        "locator": {
          "type": "string",
          "pattern": "^[A-Za-z0-9@][A-Za-z0-9._@/+~-]*$"
        },
        "tagPrefix": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9._-]*$"
        }
      }
    },
    "vulnerabilityAssessment": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["id", "ecosystem", "advisory", "package"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "ecosystem": {
          "enum": ["go", "npm", "pnpm", "pypi"]
        },
        "advisory": { "$ref": "#/$defs/nonemptyString" },
        "package": { "$ref": "#/$defs/nonemptyString" },
        "affectedVersion": {
          "type": "string",
          "pattern": "^[^*?\\[\\]<>=~^|,\\s]+$"
        },
        "scope": { "$ref": "#/$defs/concretePath" },
        "severity": {
          "enum": ["low", "moderate", "high"]
        },
        "reason": { "$ref": "#/$defs/nonemptyString" },
        "impact": { "$ref": "#/$defs/nonemptyString" },
        "evidence": { "type": "string", "pattern": "^https://" },
        "tracking": { "type": "string", "pattern": "^https://" },
        "owner": { "$ref": "#/$defs/nonemptyString" },
        "approvedBy": { "$ref": "#/$defs/nonemptyString" },
        "approval": { "type": "string", "pattern": "^https://" },
        "reviewed": { "type": "string", "format": "date" },
        "expires": { "type": "string", "format": "date" }
      },
      "allOf": [
        { "required": ["affectedVersion", "scope", "severity", "status"] },
        { "required": ["basis", "reason", "impact", "evidence"] },
        { "required": ["tracking", "owner", "approvedBy", "approval"] },
        { "required": ["reviewed", "expires"] }
      ],
      "oneOf": [
        {
          "properties": {
            "status": { "const": "not-affected" },
            "basis": {
              "enum": ["false-positive", "unreachable"]
            }
          }
        },
        {
          "properties": {
            "severity": {
              "enum": ["low", "moderate"]
            },
            "status": { "const": "risk-accepted" },
            "basis": {
              "enum": ["mitigated", "temporary-no-fix"]
            }
          }
        }
      ]
    },
    "releaseAgeAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ecosystem", "package", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "ecosystem": {
          "enum": ["artifact", "go", "npm", "pnpm", "pypi"]
        },
        "package": { "$ref": "#/$defs/nonemptyString" },
        "version": { "$ref": "#/$defs/nonemptyString" },
        "scope": { "$ref": "#/$defs/concretePath" },
        "category": {
          "enum": ["security-fix", "supported-release"]
        },
        "evidence": { "type": "string", "pattern": "^https://" },
        "reason": { "$ref": "#/$defs/nonemptyString" },
        "owner": { "$ref": "#/$defs/nonemptyString" },
        "reviewed": { "type": "string", "format": "date" },
        "expires": { "type": "string", "format": "date" }
      },
      "allOf": [
        { "required": ["scope", "category", "evidence", "reason"] },
        { "required": ["owner", "reviewed", "expires"] }
      ]
    },
    "dependencyOverridePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ecosystem", "path", "field"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "ecosystem": {
          "enum": ["npm", "pnpm"]
        },
        "path": { "$ref": "#/$defs/concretePath" },
        "field": {
          "enum": ["overrides", "pnpm.overrides"]
        },
        "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reason": { "$ref": "#/$defs/nonemptyString" },
        "owner": { "$ref": "#/$defs/nonemptyString" },
        "reviewed": { "type": "string", "format": "date" },
        "expires": { "type": "string", "format": "date" }
      },
      "allOf": [
        { "required": ["contentSha256", "reason", "owner"] },
        { "required": ["reviewed", "expires"] }
      ]
    },
    "policyModules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overrides": {
          "type": "array",
          "items": { "$ref": "#/$defs/policyModuleOverride" }
        }
      }
    },
    "policyModuleOverride": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["name", "mode"],
      "properties": {
        "name": {
          "enum": ["electron", "osv", "react", "ruff", "ty", "vulture"]
        },
        "root": { "$ref": "#/$defs/concretePath" },
        "reason": { "$ref": "#/$defs/nonemptyString" },
        "owner": { "$ref": "#/$defs/nonemptyString" },
        "expires": { "type": "string", "format": "date" }
      },
      "oneOf": [
        {
          "properties": { "mode": { "const": "disabled" } },
          "required": ["reason", "owner", "expires"]
        },
        {
          "properties": {
            "mode": { "const": "enabled" },
            "reason": false,
            "owner": false,
            "expires": false
          }
        }
      ]
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check", "path", "subject"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "check": { "type": "string", "pattern": "^[^*?\\[\\]]+$" },
        "path": { "$ref": "#/$defs/concretePath" },
        "subject": { "type": "string", "pattern": "^[^*?\\[\\]]+$" },
        "reason": { "$ref": "#/$defs/nonemptyString" },
        "owner": { "$ref": "#/$defs/nonemptyString" },
        "expires": { "type": "string", "format": "date" }
      },
      "allOf": [{ "required": ["reason", "owner", "expires"] }]
    }
  }
}
