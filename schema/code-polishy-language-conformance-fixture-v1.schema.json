{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/riteofstring/code-polishy/main/schema/code-polishy-language-conformance-fixture-v1.schema.json",
  "title": "Code Polishy language conformance fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "id",
    "maturity",
    "behaviorIds",
    "files",
    "git",
    "arguments",
    "timeoutSeconds",
    "platforms",
    "expected"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "protocol": { "const": "language-conformance-fixture/v1" },
    "id": { "$ref": "#/$defs/identifier" },
    "maturity": { "enum": ["active", "planned"] },
    "gap": { "$ref": "#/$defs/text" },
    "behaviorIds": { "$ref": "#/$defs/requiredStrings" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/file" }
    },
    "laneOverrides": { "$ref": "#/$defs/laneOverrides" },
    "git": { "$ref": "#/$defs/git" },
    "arguments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/text" }
    },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "platforms": { "$ref": "#/$defs/requiredStrings" },
    "expected": { "$ref": "#/$defs/expected" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "maturity": { "const": "planned" } },
        "required": ["maturity"]
      },
      "then": { "required": ["gap"] },
      "else": { "not": { "required": ["gap"] } }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).*\\S.*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": ".*\\S.*"
    },
    "strings": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "requiredStrings": {
      "allOf": [{ "$ref": "#/$defs/strings" }],
      "minItems": 1
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "mode": { "enum": ["0644", "0755"] },
        "content": { "type": "string" },
        "contentBase64": { "type": "string", "contentEncoding": "base64" }
      },
      "oneOf": [
        { "required": ["content"], "not": { "required": ["contentBase64"] } },
        { "required": ["contentBase64"], "not": { "required": ["content"] } }
      ]
    },
    "laneOverrides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "candidate"],
      "properties": {
        "reference": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/file" }
        },
        "candidate": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/file" }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commitTimestamp", "changes"],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "commitTimestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "changes": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/gitChange" }
        }
      }
    },
    "gitChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state", "staged"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "state": { "enum": ["modified", "untracked", "deleted"] },
        "staged": { "type": "boolean" },
        "mode": { "enum": ["0644", "0755"] },
        "content": { "type": "string" },
        "contentBase64": { "type": "string", "contentEncoding": "base64" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "deleted" } },
            "required": ["state"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["mode"] },
                { "required": ["content"] },
                { "required": ["contentBase64"] }
              ]
            }
          },
          "else": {
            "required": ["mode"],
            "oneOf": [
              {
                "required": ["content"],
                "not": { "required": ["contentBase64"] }
              },
              {
                "required": ["contentBase64"],
                "not": { "required": ["content"] }
              }
            ]
          }
        }
      ]
    },
    "expectedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exitStatus",
        "reportStatus",
        "requiredRules",
        "requiredCoverage",
        "writes",
        "protected"
      ],
      "properties": {
        "exitStatus": { "enum": [0, 1, 2] },
        "reportStatus": { "enum": ["passed", "failed"] },
        "requiredRules": { "$ref": "#/$defs/strings" },
        "requiredCoverage": { "$ref": "#/$defs/strings" },
        "writes": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectedFile" }
        },
        "protected": { "$ref": "#/$defs/strings" }
      }
    }
  }
}
